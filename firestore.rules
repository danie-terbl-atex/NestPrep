rules_version = '2';

// GENERATED by `npm --prefix functions run rules:build` from rules/firestore/.
// Do not edit this file: edit the partial named above each block, then build.
// A merge conflict here is never resolved by hand — take either side and build.
//
// NestPrep's authorisation and validation layer (foundation ADR-0002). Deny by
// default; every match states who may read and who may write, and every rule has
// an allowed and a denied test in `functions/test/rules/` (BE-05, BE-14).
//
// Membership is read from the household document's uid→role map, which only
// Cloud Functions write. Everything a household owns is nested under it, so the
// scope is structural rather than repeated per collection.
service cloud.firestore {
  match /databases/{database}/documents {
    // ==== rules/firestore/shared/access.rules ====
    // ---- what the caller may see and do, per area (household ADR-0003) ----
    //
    // Family — admin, parent, and the old `member` — sees and does everything,
    // as every member did before. A kid, helper or carer holds one level per
    // area: `none`, `own` (only what is theirs), `view` (read) or `edit` (what
    // family does). A claimed member's level is in the household's `access`
    // map, which only Functions write; a helper claimed before ADR-0003 has no
    // entry and keeps `edit` everywhere until a parent chooses; a kid or carer
    // with none has nothing.
    //
    // A kid device's level is the `access` its kid profile holds — the one
    // place a parent's choice is written, so the access editor governs the
    // child's tablet too — and only while that profile's role is `kid`: a
    // profile moved to any other role leaves its devices with nothing
    // (accounts ADR-0004).
    //
    // The area keys are a contract other features gate on — the household
    // overview lists them, and `functions/test/unit/access_contract.test.ts`
    // checks the rules against `functions/src/household/access.ts`. Gate a new
    // collection on `canView` / `canEdit` / `hasOwnOnly` and it is right for
    // helpers, carers, kids and kid devices at once; never on a role name.

    function isFamily(householdId) {
      return isMember(householdId)
        && householdData(householdId).members[uid()] in ['admin', 'parent', 'member'];
    }

    function memberLevelIn(householdId, area) {
      let household = householdData(householdId);
      let grant = household.get('access', {}).get(uid(), null);
      return grant != null
        ? grant.get(area, 'none')
        : (household.members[uid()] == 'helper' ? 'edit' : 'none');
    }

    function kidDeviceLevelIn(householdId, area) {
      let profile = memberData(householdId, kidMemberId(householdId));
      return profile.role == 'kid' ? profile.get('access', {}).get(area, 'none') : 'none';
    }

    // Only ever asked once `isInHousehold` holds.
    function levelIn(householdId, area) {
      return isMember(householdId)
        ? memberLevelIn(householdId, area)
        : kidDeviceLevelIn(householdId, area);
    }

    function canView(householdId, area) {
      return isFamily(householdId)
        || (isInHousehold(householdId) && levelIn(householdId, area) in ['view', 'edit']);
    }

    function canEdit(householdId, area) {
      return isFamily(householdId)
        || (isInHousehold(householdId) && levelIn(householdId, area) == 'edit');
    }

    function hasOwnOnly(householdId, area) {
      return isInHousehold(householdId) && !isFamily(householdId)
        && levelIn(householdId, area) == 'own';
    }

    // The member id this caller is, which is what `own` compares with: the
    // profile a member claimed, or the profile a kid device is bound to.
    // Empty for an account claimed before ADR-0003, which never holds `own`.
    function ownMemberId(householdId) {
      return isKid(householdId)
        ? kidMemberId(householdId)
        : householdData(householdId).get('profiles', {}).get(uid(), '');
    }

    function isGrant(value) {
      return value == null
        || (value is map
            && value.keys().hasOnly(
                 ['calendar', 'groceries', 'todos', 'meals', 'documents', 'lunch',
                  'familyProfiles', 'medical', 'homeCare', 'nannyHub'])
            && value.values().hasOnly(['none', 'own', 'view', 'edit']));
    }

    // The profile this caller acts as. Anything a member creates is stamped
    // with it, so nobody can write an item in somebody else's name (BE-03). A
    // kid device acts as its kid profile, so what its grant lets it do it does
    // as that child (accounts ADR-0004).
    function isOwnMember(householdId, memberId) {
      return isKidAs(householdId, memberId) || hasClaimed(householdId, memberId);
    }

    // The profile this account claimed, and nothing else — for what only a
    // person with their own login may do, like sharing where they are.
    function hasClaimed(householdId, memberId) {
      return isSignedIn() && memberData(householdId, memberId).claimedBy == uid();
    }

    // ==== rules/firestore/shared/caller.rules ====
    // ---- who the caller is ----

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ---- what the caller is in a household ----

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isMember(householdId) {
      return isSignedIn() && uid() in householdData(householdId).members;
    }

    function isAdmin(householdId) {
      return isMember(householdId) && householdData(householdId).members[uid()] == 'admin';
    }

    function memberData(householdId, memberId) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(memberId)).data;
    }

    // ==== rules/firestore/shared/entitlement.rules ====
    // ---- premium (subscriptions ADR-0001) ----
    //
    // Whether a household has premium right now. The entitlement document is
    // written only by Functions, after a store has vouched for a purchase; its
    // `premiumUntil` is compared with the request's own time, so premium ends at
    // its instant without anything having to notice. A missing document, a
    // missing field or anything that is not a timestamp is free.
    //
    // A feature gates a premium write with `&& hasPremium(householdId)` beside
    // its area grant — lunch-box's learning loop and prep list are the first
    // (subscriptions overview, *Contracts*). Gate writes, not reads: a household
    // that lapses keeps reading everything it made (subscriptions ADR-0001).
    // `functions/src/subscriptions/subscription_documents.ts` holds the
    // Functions' copy, `householdHasPremium`.

    function hasPremium(householdId) {
      let path = /databases/$(database)/documents/households/$(householdId)/entitlement/current;
      let until = exists(path) ? get(path).data.get('premiumUntil', null) : null;
      return until is timestamp && until > request.time;
    }

    // ==== rules/firestore/shared/kid_devices.rules ====
    // ---- kid devices (accounts ADR-0003, ADR-0004) ----
    //
    // A kid device is **not a member**: it is never in the uid→role map, so no
    // `isMember()` admits it and no membership rule or callable treats it as
    // an adult. It is recorded in the household's `kids` map (uid → the member
    // profile the device is signed in as), which only Functions write and a
    // parent empties in one call; the rules read that map, never the token's
    // `kidProfile` claim, which would outlive a revoke until the token
    // refreshed. What a kid device may *see* is not decided here: it holds the
    // grant of the kid profile it is bound to, through `canView` and friends
    // below (accounts ADR-0004).

    function isKid(householdId) {
      return isSignedIn() && uid() in householdData(householdId).get('kids', {});
    }

    function kidMemberId(householdId) {
      return householdData(householdId).kids[uid()];
    }

    function isKidAs(householdId, memberId) {
      return isKid(householdId) && kidMemberId(householdId) == memberId;
    }

    // A member by the uid→role map, or a kid device by the `kids` map.
    function isInHousehold(householdId) {
      return isMember(householdId) || isKid(householdId);
    }

    // ==== rules/firestore/shared/shapes.rules ====
    // ---- shapes ----

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(fields) {
      return changedKeys().hasOnly(fields);
    }

    function didNotChange(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // A timestamp the server assigns, never one the client chose (BE-03).
    function isServerTime(field) {
      return request.resource.data[field] == request.time;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // `member` is household ADR-0001's family adult. An app installed before
    // ADR-0003 still writes it, so it is still accepted, and read as parent.
    function isRole(value) {
      return value in ['admin', 'parent', 'member', 'kid', 'helper', 'carer'];
    }

    // A member's birthday (birthdays ADR-0001): absent, null, `YYYY-MM-DD`, or
    // `--MM-DD` where the household does not know the year. The month and the
    // day are range-checked here; that 31 February is not a day is the only
    // part left to the client, because the rules language cannot count the
    // days in a month and a wrong one is a wrong date in one household's own
    // profile, not a way into anybody's data (BE-03).
    function isBirthday(value) {
      return value == null
        || (value is string
            && (value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
                || value.matches('^--(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')));
    }

    // ==== rules/firestore/root/accounts.rules ====
    // ---- accounts (accounts ADR-0001) ----

    match /users/{userId} {
      function isSelf() {
        return isSignedIn() && userId == uid();
      }

      allow read: if isSelf();

      // A new account belongs to no household and has none active: only a
      // Function may change that (household ADR-0002). A kid device has no
      // account document at all — it belongs to one household, through the
      // `kids` map, and to nothing else (accounts ADR-0003).
      allow create: if isSelf()
        && request.auth.token.get('kidProfile', null) == null
        && request.resource.data.keys().hasOnly(
             ['displayName', 'photoUrl', 'householdIds', 'activeHouseholdId',
              'createdAt', 'lastSignedInAt'])
        && isNonEmptyString(request.resource.data.displayName)
        && request.resource.data.householdIds.size() == 0
        && request.resource.data.activeHouseholdId == null
        && isServerTime('createdAt');

      // What Google tells us about the person, and which household is showing.
      // `householdIds` and `createdAt` are not in the list, so they cannot move.
      allow update: if isSelf()
        && onlyChanged(['displayName', 'photoUrl', 'activeHouseholdId', 'lastSignedInAt'])
        && isNonEmptyString(request.resource.data.displayName)
        && (request.resource.data.activeHouseholdId == null
            || request.resource.data.activeHouseholdId in resource.data.householdIds)
        && (!changedKeys().hasAny(['lastSignedInAt']) || isServerTime('lastSignedInAt'));

      // Deleting an account is a Function, in the phase that ships to a store.
      allow delete: if false;
    }

    // ==== rules/firestore/root/app_config.rules ====
    // ---- app configuration: V2 flags and the AI switch (foundation ADR-0014, ADR-0015) ----
    // `appConfig/flags` is one boolean per V2 capability. Anybody signed in may
    // get it — it is a list of switches, not anybody's data — and no client may
    // write it: Daniel sets it in the console. `appConfig/ai` is the AI kill
    // switch and the monthly caps, read only by Functions; a client has no
    // reason to know the caps, and must never be able to raise them. Any other
    // id here is closed too, so the collection cannot quietly grow into a place
    // for data, and nobody lists it.
    // `aiEmulator/{feature}` holds the canned model answers the Functions
    // emulator uses; it has no rule, so no client reads or writes it.

    match /appConfig/{configId} {
      allow get: if isSignedIn() && configId == 'flags';
      allow list: if false;
      allow write: if false;
    }

    // ==== rules/firestore/root/calendar_sync.rules ====
    // ---- calendar sync, the credentials (calendar ADR-0003) ----
    // A refresh token or a calendar link, a connection in flight, and a feed
    // token's hash. Only the calendar sync Functions touch these; a readable
    // one would be somebody's whole calendar.
    match /calendarConnectionSecrets/{connectionId} {
      allow read, write: if false;
    }

    match /calendarOAuthStates/{state} {
      allow read, write: if false;
    }

    match /calendarFeeds/{tokenHash} {
      allow read, write: if false;
    }

    // ==== rules/firestore/root/coparent.rules ====
    // ---- co-parenting: codes and the authority (household ADR-0004) ----
    // Closed to every client. A readable code collection is a list of ways into
    // a child's week; the authority names both households of a link, which is
    // exactly what neither home may learn about the other. The co-parenting
    // Functions are the only way in.
    match /coParentInvites/{code} {
      allow read, write: if false;
    }

    match /coParentLinks/{linkId} {
      allow read, write: if false;
    }

    // ==== rules/firestore/root/document_shares.rules ====
    // ---- documents: a shared link's secrets (documents ADR-0006) ----
    // Keyed by the hash of the link's token, holding the PIN's hash and how
    // many wrong PINs it has seen. Only the shared-link Functions read or
    // write these; a readable one would be a way to test PINs offline.
    match /documentShareTokens/{tokenHash} {
      allow read, write: if false;
    }

    // ==== rules/firestore/root/invites.rules ====
    // ---- invites (household ADR-0002) ----
    // No client reads or writes these at all: a readable invite collection is a
    // list of valid codes. `createInvite` and `redeemInvite` are the only way in.
    match /invites/{code} {
      allow read, write: if false;
    }

    // ==== rules/firestore/root/kid_pairings.rules ====
    // ---- kid pairing codes (accounts ADR-0003) ----
    // Closed for the same reason invites are: a readable collection of codes
    // is a list of ways into somebody's household. `createKidPairing`,
    // `cancelKidPairing` and `redeemKidPairing` are the only way in.
    match /kidPairings/{code} {
      allow read, write: if false;
    }

    // ==== rules/firestore/root/product_analytics.rules ====
    // ---- product analytics (product-analytics ADR-0001) ----
    // The per-household ledgers are written by Functions alone and read by the
    // rollup alone: a readable ledger would say which members of which household
    // opened the app in which week. No household may read its own either — the
    // numbers are about the product, never a view of one family. The weekly
    // totals are counts with no identifier in them, readable only by an account
    // holding the reader claim `functions/tools/grant-analytics-reader.mjs` sets.

    match /analyticsHouseholdWeeks/{entryId} {
      allow read, write: if false;
    }

    match /analyticsHouseholds/{householdId} {
      allow read, write: if false;
    }

    match /analyticsConversions/{conversionId} {
      allow read, write: if false;
    }

    match /analyticsWeeks/{week} {
      allow read: if isSignedIn() && request.auth.token.get('analyticsReader', false) == true;
      allow write: if false;
    }

    // ==== rules/firestore/root/subscriptions.rules ====
    // ---- subscriptions (subscriptions ADR-0001) ----
    // One document per store subscription: its purchase token or original
    // transaction id, the household it gives premium to and who linked it.
    // Functions alone read and write it. A purchase token is the store's
    // credential for a payment, not something to hand to every phone in a
    // household, and the link is what stops one store account unlocking many.

    match /storePurchases/{purchaseKey} {
      allow read, write: if false;
    }

    // ---- households (household ADR-0001, ADR-0002) ----

    match /households/{householdId} {
      // ==== rules/firestore/household/ai_usage.rules ====
      // ---- AI usage ledger (foundation ADR-0015) ----
      // A household's monthly AI calls and one line per call, written only by
      // Functions inside the transaction that claims the call. No client reads
      // them — the callable tells the app how many calls are left — and none
      // writes them, or the cap would be the client's to lower.

      match /aiUsage/{month} {
        allow read, write: if false;

        match /calls/{callId} {
          allow read, write: if false;
        }
      }

      // ==== rules/firestore/household/calendar.rules ====
      // ---- calendar (calendar ADR-0001, ADR-0002) ----

      match /events/{eventId} {
        allow read: if canView(householdId, 'calendar');

        // Any member creates an event for anyone; the creator or an admin edits
        // and deletes it (calendar ADR-0001). The time is the household's wall
        // clock, so `startMinute` is minutes since midnight or absent for an
        // all-day event (calendar ADR-0002).
        allow create: if canEdit(householdId, 'calendar')
          && request.resource.data.keys().hasOnly(
               ['title', 'note', 'date', 'startMinute', 'endMinute', 'recurrence',
                'memberIds', 'createdBy', 'createdAt'])
          && isNonEmptyString(request.resource.data.title)
          && isNonEmptyString(request.resource.data.date)
          && isMinuteOfDay(request.resource.data.startMinute)
          && isMinuteOfDay(request.resource.data.endMinute)
          && request.resource.data.memberIds is list
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if canEdit(householdId, 'calendar')
          && onlyChanged(
               ['title', 'note', 'date', 'startMinute', 'endMinute', 'recurrence',
                'memberIds'])
          && isNonEmptyString(request.resource.data.title)
          && isNonEmptyString(request.resource.data.date)
          && isMinuteOfDay(request.resource.data.startMinute)
          && isMinuteOfDay(request.resource.data.endMinute)
          && (isAdmin(householdId)
                || isOwnMember(householdId, resource.data.createdBy));

        allow delete: if isAdmin(householdId)
          || (canEdit(householdId, 'calendar')
                && isOwnMember(householdId, resource.data.createdBy));

        function isMinuteOfDay(value) {
          return value == null || (value is int && value >= 0 && value < 1440);
        }
      }

      // One occurrence of a repeating event, skipped. Same shape and the same
      // reasons as a task completion (todos ADR-0002).
      match /eventExceptions/{exceptionId} {
        allow read: if canView(householdId, 'calendar');

        allow create, update: if canEdit(householdId, 'calendar')
          && request.resource.data.keys().hasOnly(
               ['eventId', 'occurrenceDate', 'skippedBy', 'skippedAt'])
          && exceptionId ==
               request.resource.data.eventId + '_' + request.resource.data.occurrenceDate
          && isOwnMember(householdId, request.resource.data.skippedBy)
          && isServerTime('skippedAt');

        allow delete: if canEdit(householdId, 'calendar');
      }

      // ==== rules/firestore/household/calendar_sync.rules ====
      // ---- calendar sync (calendar ADR-0003) ----
      // What the household sees of its connected calendars, the events they
      // brought in, and its own feed link. They are the family week, so whoever
      // the `calendar` grant lets see the week sees them — a kid's tablet included,
      // through its profile's grant (household ADR-0003, accounts ADR-0004). Only
      // the calendar sync Functions write them, so an imported event cannot be
      // edited here and a connection cannot be pointed at somebody else.
      match /calendarConnections/{connectionId} {
        allow read: if canView(householdId, 'calendar');
        allow write: if false;
      }

      match /syncedEvents/{syncedEventId} {
        allow read: if canView(householdId, 'calendar');
        allow write: if false;
      }

      match /calendarFeed/{feedId} {
        allow read: if canView(householdId, 'calendar');
        allow write: if false;
      }

      // ==== rules/firestore/household/chore_points.rules ====
      // ---- todos phase 2: chores that earn kids stars (todos ADR-0003) ----
      //
      // A child's stars are written by Functions and by nothing else: the claim a
      // starred completion raises, the ledger, the balance beside it, and the status
      // of a reward request. A kid device — or anybody — writing any of them is
      // refused here, which is what "a kid cannot mint stars" rests on. Reading
      // follows the `todos` grant: everything at `view` or `edit`, one's own at
      // `own`, which is a kid device's default (accounts ADR-0004).
      //
      // What family may do that a grant never gives: put stars on a chore, write
      // the reward shelf. Approving a chore and handing a reward over are callables
      // that check the same thing (`reviewChore`, `settleReward`).

      // A chore's stars: a whole number from 0 to 100, a yes/no for a parent's
      // check, and a starred chore names the children who earn it — an "anyone"
      // chore is invisible to a kid device reading `own` (todos ADR-0003).
      function choreStarsAreValid(data) {
        let points = data.get('points', 0);
        return points is int && points >= 0 && points <= 100
          && data.get('needsApproval', false) is bool
          && (points == 0 || data.assigneeIds.size() > 0);
      }

      function choreCarriesStars(data) {
        return data.get('points', 0) != 0 || data.get('needsApproval', false) != false;
      }

      function choreStarsUnchanged() {
        return request.resource.data.get('points', 0) == resource.data.get('points', 0)
          && request.resource.data.get('needsApproval', false)
               == resource.data.get('needsApproval', false);
      }

      // Somebody's stars: anybody who sees the household's to-dos, or the child
      // they belong to.
      function choreStarsReadable(householdId, memberId) {
        return canView(householdId, 'todos')
          || (hasOwnOnly(householdId, 'todos') && memberId == ownMemberId(householdId));
      }

      function isRewardShape(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 60
          && data.cost is int && data.cost >= 1 && data.cost <= 10000
          && data.icon is string && data.icon.size() > 0 && data.icon.size() <= 32;
      }

      match /pointBalances/{memberId} {
        allow read: if choreStarsReadable(householdId, memberId);
        allow write: if false;
      }

      match /pointEntries/{entryId} {
        allow read: if choreStarsReadable(householdId, resource.data.memberId);
        allow write: if false;
      }

      match /pointClaims/{claimId} {
        allow read: if choreStarsReadable(householdId, resource.data.memberId);
        allow write: if false;
      }

      // The household's shelf: every child sees the same one.
      match /rewards/{rewardId} {
        allow read: if canView(householdId, 'todos') || hasOwnOnly(householdId, 'todos');

        allow create: if isFamily(householdId)
          && request.resource.data.keys().hasOnly(
               ['title', 'cost', 'icon', 'createdBy', 'createdAt'])
          && isRewardShape(request.resource.data)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if isFamily(householdId)
          && onlyChanged(['title', 'cost', 'icon'])
          && isRewardShape(request.resource.data);

        allow delete: if isFamily(householdId);
      }

      // A child asks for a reward — or a parent asks on a child's behalf. Four
      // fields and nothing else: the status, the cost taken and the refusal are
      // the trigger's to write, never the asker's.
      match /rewardRequests/{requestId} {
        allow read: if choreStarsReadable(householdId, resource.data.memberId);

        allow create: if (canEdit(householdId, 'todos') || hasOwnOnly(householdId, 'todos'))
          && request.resource.data.keys().hasOnly(
               ['rewardId', 'memberId', 'requestedBy', 'requestedAt'])
          && isNonEmptyString(request.resource.data.rewardId)
          && isOwnMember(householdId, request.resource.data.requestedBy)
          && (isOwnMember(householdId, request.resource.data.memberId)
                || isFamily(householdId))
          && exists(/databases/$(database)/documents/households/$(householdId)/rewards/$(request.resource.data.rewardId))
          && isServerTime('requestedAt');

        allow update, delete: if false;
      }

      // ==== rules/firestore/household/coparent.rules ====
      // ---- co-parenting: a child in two homes (household ADR-0004) ----
      // This household's own copy of a link with another home. Only the
      // co-parenting Functions write it — both homes' copies in one transaction —
      // so no client ever writes across households. It is read here under this
      // household's grants and nothing else: no rule names the other household,
      // so no read a phone can make reaches the other home's data.
      //
      // The link and its schedule are where the child is, so they are read with
      // the calendar. A handover carries medicine given, so it needs `medical`
      // too. Requests are a negotiation between the adults who run the week, so
      // they are read by whoever may change the calendar.
      match /coParentLinks/{linkId} {
        allow read: if canView(householdId, 'calendar');
        allow write: if false;

        match /handovers/{date} {
          allow read: if canView(householdId, 'calendar') && canView(householdId, 'medical');
          allow write: if false;
        }

        match /requests/{requestId} {
          allow read: if canEdit(householdId, 'calendar');
          allow write: if false;
        }
      }

      // ==== rules/firestore/household/document_shares.rules ====
      // ---- documents: one document shared by an expiring link (documents ADR-0006) ----
      // What the family sees of a link — which document, when it ends, whether it
      // has a PIN, how often it was opened — never the link itself, which exists
      // only on the phone that made it. The family reads every link; anybody else
      // reads only a link they made, while they are still in the household. Only
      // `createDocumentShare`, `revokeDocumentShare`, the link itself and the
      // shift trigger write here, so a count or a status cannot be forged.
      match /documentShares/{shareId} {
        allow read: if isFamily(householdId)
          || (isMember(householdId) && resource.data.createdByUid == uid());
        allow write: if false;
      }

      // ==== rules/firestore/household/document_vaults.rules ====
      // ---- documents phase 2: tags, expiry, personal vaults ----
      // (documents ADR-0002, ADR-0003, ADR-0005)

      // At most eight tags of 1–24 characters. Rules have no loops, so the
      // eight places are spelled out; a ninth fails the size check first.
      function isTagAt(tags, index) {
        return index >= tags.size()
          || (tags[index] is string && tags[index].size() > 0 && tags[index].size() <= 24);
      }

      function isTags(tags) {
        return tags is list && tags.size() <= 8
          && isTagAt(tags, 0) && isTagAt(tags, 1) && isTagAt(tags, 2) && isTagAt(tags, 3)
          && isTagAt(tags, 4) && isTagAt(tags, 5) && isTagAt(tags, 6) && isTagAt(tags, 7);
      }

      // A day in the household's zone, `YYYY-MM-DD`, or none (ENG-21).
      function isExpiry(value) {
        return value == null
          || (value is string
              && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
      }

      // Shared by the household's documents and the vaults.
      function hasDocumentDetails() {
        return isTags(request.resource.data.get('tags', []))
          && isExpiry(request.resource.data.get('expiresOn', null));
      }

      // A member's own vault. The owner is the path, never a field, so no query
      // has to prove it. Read and changed by its owner and by the family —
      // `isFamily`, household ADR-0003, which keeps per-item privacy between family
      // members out of v1 — and readable by anybody else only once the owner or a
      // family member grants it. A helper reads no ID copy unless granted it; a
      // kid's tablet has no vault of its own (`hasClaimed`, a login, not a device
      // — accounts ADR-0004).
      match /vaults/{ownerMemberId} {
        function isVaultOwner() {
          return isMember(householdId) && hasClaimed(householdId, ownerMemberId);
        }

        function mayManageVault() {
          return isFamily(householdId) || isVaultOwner();
        }

        function isGrantedVault() {
          return isMember(householdId)
            && exists(/databases/$(database)/documents/households/$(householdId)/vaults/$(ownerMemberId)/grants/$(uid()));
        }

        match /vaultDocuments/{documentId} {
          allow read: if mayManageVault() || isGrantedVault();

          allow create: if mayManageVault()
            && request.resource.data.keys().hasOnly(
                 ['name', 'contentType', 'sizeBytes', 'uploadedBy', 'uploadedAt',
                  'tags', 'expiresOn'])
            && isDocumentName(request.resource.data.name)
            && isKeptType(request.resource.data.contentType)
            && isSmallEnough(request.resource.data.sizeBytes)
            && hasDocumentDetails()
            && isOwnMember(householdId, request.resource.data.uploadedBy)
            && isServerTime('uploadedAt');

          allow update: if mayManageVault()
            && onlyChanged(['name', 'tags', 'expiresOn'])
            && isDocumentName(request.resource.data.name)
            && hasDocumentDetails();

          allow delete: if mayManageVault();
        }

        // Keyed by the grantee's uid, because that is what these rules know.
        // The uid must be the claimant of the named profile and in the
        // household, so a grant can name neither a stranger nor somebody
        // else's profile. Read-only access; revoking is deleting.
        match /grants/{granteeUid} {
          allow read: if mayManageVault()
            || (isMember(householdId) && uid() == granteeUid);

          allow create: if mayManageVault()
            && request.resource.data.keys().hasOnly(['memberId', 'grantedBy', 'grantedAt'])
            && request.resource.data.memberId != ownerMemberId
            && granteeUid in householdData(householdId).members
            && memberData(householdId, request.resource.data.memberId).claimedBy == granteeUid
            && isOwnMember(householdId, request.resource.data.grantedBy)
            && isServerTime('grantedAt');

          allow update: if false;
          allow delete: if mayManageVault();
        }

        // Written only by `openVaultDocument`, in the same batch as the
        // ticket the bytes need — so the log cannot be skipped, and nobody
        // edits it (documents ADR-0003).
        match /views/{viewId} {
          allow read: if mayManageVault();
          allow write: if false;
        }
      }

      // ==== rules/firestore/household/documents.rules ====
      // ---- documents (documents ADR-0001) ----

      // The household's filing cabinet: one level of folders, no nesting. A
      // folder is admin-managed because renaming one changes what everybody
      // else sees, which is why a routine is admin-only too (todos ADR-0001).
      //
      // Deleting one is `deleteDocumentFolder`, not a client write: rules
      // cannot count the documents in a collection, and a folder deleted out
      // from under its documents leaves bytes nobody can see and nobody stops
      // paying for (foundation ADR-0002, BE-07).
      match /documentFolders/{folderId} {
        allow read: if canView(householdId, 'documents');

        allow create: if isAdmin(householdId)
          && request.resource.data.keys().hasOnly(
               ['name', 'createdBy', 'createdAt'])
          && isDocumentName(request.resource.data.name)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if isAdmin(householdId)
          && onlyChanged(['name'])
          && isDocumentName(request.resource.data.name);

        allow delete: if false;
      }

      // What a document *is*; the bytes are the Storage object of the same
      // name, guarded by `storage.rules`. Size and content type are stored for
      // the label a person reads — the limits that matter are enforced where
      // the bytes are, because that is the only place that can see them
      // (BE-03).
      match /documents/{documentId} {
        allow read: if canView(householdId, 'documents');

        // `tags` and `expiresOn` are optional and additive (documents
        // ADR-0005): rows written before them have neither (BE-10).
        allow create: if canEdit(householdId, 'documents')
          && request.resource.data.keys().hasOnly(
               ['folderId', 'name', 'contentType', 'sizeBytes', 'uploadedBy',
                'uploadedAt', 'tags', 'expiresOn'])
          && isNonEmptyString(request.resource.data.folderId)
          && isDocumentName(request.resource.data.name)
          && isKeptType(request.resource.data.contentType)
          && isSmallEnough(request.resource.data.sizeBytes)
          && hasDocumentDetails()
          && isOwnMember(householdId, request.resource.data.uploadedBy)
          && isServerTime('uploadedAt');

        // Renaming, moving between folders, tagging and dating; the bytes never
        // change, so neither does anything describing them.
        allow update: if canEdit(householdId, 'documents')
          && onlyChanged(['name', 'folderId', 'tags', 'expiresOn'])
          && isDocumentName(request.resource.data.name)
          && isNonEmptyString(request.resource.data.folderId)
          && hasDocumentDetails()
          && (isAdmin(householdId)
                || isOwnMember(householdId, resource.data.uploadedBy));

        allow delete: if isAdmin(householdId)
          || (canEdit(householdId, 'documents')
                && isOwnMember(householdId, resource.data.uploadedBy));
      }

      // A name somebody typed, bounded so a document list cannot be used as a
      // place to store a megabyte of text for free.
      function isDocumentName(value) {
        return isNonEmptyString(value) && value.size() <= 80;
      }

      function isKeptType(value) {
        return value in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/heic',
          'image/webp'
        ];
      }

      function isSmallEnough(value) {
        return value is int && value > 0 && value <= 20 * 1024 * 1024;
      }

      // ==== rules/firestore/household/family_profiles.rules ====
      // ---- family profiles (family-profiles ADR-0001, ADR-0002) ----
      //
      // What the household knows about each person, beside the member rather
      // than on it, because rules can hide a document and never a field. The
      // document id is the member id, so there is no field to put somebody
      // else's id into. An admin writes anybody's; everybody else writes only
      // their own. Nobody deletes one: it goes with its member, inside
      // `removeMember`, so a removed child's health data does not outlive them.
      // Every client write is a merge, so these rules judge the document as it
      // will be after the write.
      //
      // Who reads what is the household's grant (household ADR-0003, family-profiles
      // ADR-0002): a profile — allergies included — by the `familyProfiles` area,
      // medication by the `medical` area, each at `own` only for the caller's own
      // member (a kid device's own is the profile it is bound to, accounts
      // ADR-0004). A person with their own login always reads and writes their own
      // profile and medication, whatever the grant: it is about them.

      match /familyProfiles/{memberId} {
        // Allergies live here rather than behind `medical`: whoever the household
        // lets see a child's profile — the person packing a lunch — must be able to
        // see what the child cannot eat (family-profiles ADR-0002).
        allow read: if canView(householdId, 'familyProfiles')
          || (hasOwnOnly(householdId, 'familyProfiles') && memberId == ownMemberId(householdId))
          || hasClaimed(householdId, memberId);

        allow create: if mayEditProfile(householdId, memberId)
          && memberExists(householdId, memberId)
          && isFamilyProfile(request.resource.data)
          && !request.resource.data.get('isChild', false)
          && isKnownSchool(householdId, request.resource.data.get('schoolId', null));

        // Who is a child is what the free tier counts, and rules cannot count:
        // `isChild` is written only by `setChildProfile`, which counts in a
        // transaction (subscriptions ADR-0001). A client write leaves it as it is.
        // The school is checked only when it moves: a school deleted after a
        // child pointed at it must not lock the rest of that child's profile.
        allow update: if mayEditProfile(householdId, memberId)
          && isFamilyProfile(request.resource.data)
          && request.resource.data.get('isChild', false) == resource.data.get('isChild', false)
          && (request.resource.data.get('schoolId', null) == resource.data.get('schoolId', null)
              || isKnownSchool(householdId, request.resource.data.get('schoolId', null)));

        allow delete: if false;
      }

      // Medication, in a document of its own so that fewer people read it.
      match /memberHealth/{memberId} {
        allow read: if mayReadHealth(householdId, memberId);

        allow create: if mayEditProfile(householdId, memberId)
          && memberExists(householdId, memberId)
          && isMemberHealth(request.resource.data);

        allow update: if mayEditProfile(householdId, memberId)
          && isMemberHealth(request.resource.data);

        allow delete: if false;
      }

      // A school is shared by every child at it — marking one nut-free is a
      // rule for all of them — so only an admin changes one.
      match /schools/{schoolId} {
        // A school's name and whether it is nut-free say nothing about anybody,
        // and a child at `own` needs theirs beside their profile.
        allow read: if canView(householdId, 'familyProfiles')
          || hasOwnOnly(householdId, 'familyProfiles');

        allow create: if isAdmin(householdId)
          && request.resource.data.keys().hasOnly(['name', 'nutFree', 'createdAt'])
          && isBoundedText(request.resource.data.name, 80)
          && request.resource.data.nutFree is bool
          && isServerTime('createdAt');

        allow update: if isAdmin(householdId)
          && onlyChanged(['name', 'nutFree'])
          && isBoundedText(request.resource.data.name, 80)
          && request.resource.data.nutFree is bool;

        allow delete: if isAdmin(householdId);
      }

      // An admin writes anybody's profile and medication; everybody else only
      // their own, through their own login — `hasClaimed`, not `isOwnMember`, so a
      // kid device reads its profile at `own` and changes nothing in it
      // (accounts ADR-0004). A grant of `edit` does not widen this: family other
      // than an admin cannot edit somebody else's profile either.
      function mayEditProfile(householdId, memberId) {
        return isAdmin(householdId) || hasClaimed(householdId, memberId);
      }

      // Who may read a person's medication: the `medical` grant — family always,
      // a kid, helper or carer as a parent chose — and the person themselves.
      // Mirrored by `FamilyAccess.canSeeHealth` (family-profiles ADR-0002).
      function mayReadHealth(householdId, memberId) {
        return canView(householdId, 'medical')
          || (hasOwnOnly(householdId, 'medical') && memberId == ownMemberId(householdId))
          || hasClaimed(householdId, memberId);
      }

      function memberExists(householdId, memberId) {
        return exists(/databases/$(database)/documents/households/$(householdId)/members/$(memberId));
      }

      function isKnownSchool(householdId, schoolId) {
        return schoolId == null
          || (schoolId is string
              && exists(/databases/$(database)/documents/households/$(householdId)/schools/$(schoolId)));
      }

      function isBoundedText(value, longest) {
        return isNonEmptyString(value) && value.size() <= longest;
      }

      function isOptionalText(value, longest) {
        return value == null || isBoundedText(value, longest);
      }

      // Likes and dislikes. The number is `FamilyEdits.listLimit`.
      function isShortList(value) {
        return value is list && value.size() <= 30;
      }

      // The allergen and diet vocabularies are `Allergen` and `DietaryFlag`
      // in the app; `family_vocabulary_matches_the_rules_test.dart` keeps the
      // three lists the same.
      function isFamilyProfile(data) {
        return data.keys().hasOnly(
             ['isChild', 'likes', 'dislikes', 'diet', 'allergies', 'otherAllergies',
              'schoolId', 'grade', 'clothingSize', 'shoeSize'])
          && data.get('isChild', false) is bool
          && isShortList(data.get('likes', []))
          && isShortList(data.get('dislikes', []))
          && data.get('diet', []) is list
          && data.get('diet', []).hasOnly(
               ['nutFree', 'vegetarian', 'vegan', 'halal', 'kosher', 'noPork',
                'glutenFree', 'dairyFree'])
          && isAllergyMap(data.get('allergies', {}))
          && data.get('otherAllergies', {}) is map
          && data.get('otherAllergies', {}).size() <= 10
          && isOptionalText(data.get('schoolId', null), 128)
          && isOptionalText(data.get('grade', null), 40)
          && isOptionalText(data.get('clothingSize', null), 40)
          && isOptionalText(data.get('shoeSize', null), 40);
      }

      // Keyed by allergen, so the vocabulary is one `hasOnly` — and so a rule
      // elsewhere (lunch-box) can ask `allergies.keys().hasAny(...)` with one
      // read. Every value's shape is checked by name, because rules cannot loop.
      function isAllergyMap(allergies) {
        return allergies is map
          && allergies.keys().hasOnly(
               ['peanut', 'treeNut', 'milk', 'egg', 'wheat', 'soy', 'fish',
                'shellfish', 'sesame'])
          && isAllergyAt(allergies, 'peanut')
          && isAllergyAt(allergies, 'treeNut')
          && isAllergyAt(allergies, 'milk')
          && isAllergyAt(allergies, 'egg')
          && isAllergyAt(allergies, 'wheat')
          && isAllergyAt(allergies, 'soy')
          && isAllergyAt(allergies, 'fish')
          && isAllergyAt(allergies, 'shellfish')
          && isAllergyAt(allergies, 'sesame');
      }

      function isAllergyAt(allergies, code) {
        return !(code in allergies)
          || (allergies[code] is map
              && allergies[code].keys().hasOnly(['severity', 'note'])
              && allergies[code].get('severity', '') in ['mild', 'moderate', 'severe']
              && isOptionalText(allergies[code].get('note', null), 300));
      }

      // Medicines are keyed by a generated id, and rules cannot loop over a
      // map's values, so only their number is bounded here.
      function isMemberHealth(data) {
        return data.keys().hasOnly(['medications'])
          && data.get('medications', {}) is map
          && data.get('medications', {}).size() <= 12;
      }

      // ==== rules/firestore/household/groceries.rules ====
      // ---- groceries (groceries ADR-0001) ----

      match /groceryItems/{itemId} {
        allow read: if canView(householdId, 'groceries');

        allow create: if canEdit(householdId, 'groceries')
          && request.resource.data.keys().hasOnly(
               ['name', 'quantity', 'addedBy', 'addedAt', 'boughtAt', 'boughtBy'])
          && isNonEmptyString(request.resource.data.name)
          && isOwnMember(householdId, request.resource.data.addedBy)
          && isServerTime('addedAt')
          && request.resource.data.boughtAt == null
          && request.resource.data.boughtBy == null;

        // Two different writes share this rule, and a caller may do exactly one
        // of them: anybody in the household ticks anything, but only the person
        // who added an item — or an admin — changes what it says.
        allow update: if canEdit(householdId, 'groceries')
          && didNotChange('addedBy')
          && didNotChange('addedAt')
          && (isTickOrUntick(householdId) || isTextEdit(householdId));

        allow delete: if isAdmin(householdId)
          || (canEdit(householdId, 'groceries')
                && isOwnMember(householdId, resource.data.addedBy));

        function isTickOrUntick(householdId) {
          return onlyChanged(['boughtAt', 'boughtBy'])
            && (request.resource.data.boughtAt == null
                  ? request.resource.data.boughtBy == null
                  : isServerTime('boughtAt')
                      && isOwnMember(householdId, request.resource.data.boughtBy));
        }

        function isTextEdit(householdId) {
          return onlyChanged(['name', 'quantity'])
            && isNonEmptyString(request.resource.data.name)
            && (isAdmin(householdId)
                  || isOwnMember(householdId, resource.data.addedBy));
        }
      }

      // ==== rules/firestore/household/home_care.rules ====
      // ---- home care (home-care ADR-0001, ADR-0002) ----

      // Rooms and the product library: anybody with any `homeCare` level reads
      // them, because an `own` helper needs the room's name and the product
      // guide on every job; only `edit` changes them.
      match /homeCareRooms/{roomId} {
        allow read: if canView(householdId, 'homeCare')
          || hasOwnOnly(householdId, 'homeCare');

        allow create: if canEdit(householdId, 'homeCare')
          && request.resource.data.keys().hasOnly(
               ['name', 'kind', 'createdBy', 'createdAt'])
          && homeCareIsName(request.resource.data.name, 60)
          && homeCareIsRoomKind(request.resource.data.kind)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if canEdit(householdId, 'homeCare')
          && onlyChanged(['name', 'kind'])
          && homeCareIsName(request.resource.data.name, 60)
          && homeCareIsRoomKind(request.resource.data.kind);

        allow delete: if canEdit(householdId, 'homeCare');
      }

      match /homeCareProducts/{productId} {
        allow read: if canView(householdId, 'homeCare')
          || hasOwnOnly(householdId, 'homeCare');

        allow create: if canEdit(householdId, 'homeCare')
          && request.resource.data.keys().hasOnly(
               ['name', 'kind', 'whereKept', 'note', 'keepFromChildren',
                'keepFromPets', 'createdBy', 'createdAt'])
          && homeCareIsProduct(request.resource.data)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if canEdit(householdId, 'homeCare')
          && onlyChanged(
               ['name', 'kind', 'whereKept', 'note', 'keepFromChildren', 'keepFromPets'])
          && homeCareIsProduct(request.resource.data);

        allow delete: if canEdit(householdId, 'homeCare');
      }

      // A cleaning job. `own` reads only the jobs whose helper is the caller's
      // profile, and the client asks for exactly those (`helperId ==`), because
      // a rule is not a filter (household ADR-0003).
      //
      // Five statuses, moved along the edges below and no others. Every status
      // change bumps `revision` and writes `events/{revision}` in the same
      // batch, which `homeCareLogsTheChange` requires and the event rule
      // mirrors — so neither is ever written without the other.
      match /homeCareJobs/{jobId} {
        allow read: if homeCareCanSeeJob(householdId, resource.data);

        allow create: if canEdit(householdId, 'homeCare')
          && request.resource.data.keys().hasOnly(
               ['title', 'roomId', 'helperId', 'dueDate', 'note', 'productIds',
                'steps', 'doneStepIds', 'beforePhoto', 'marks', 'afterPhoto',
                'status', 'reviewNote', 'revision', 'createdBy', 'createdAt',
                'updatedAt'])
          && homeCareHasJobDetails(householdId, request.resource.data)
          && request.resource.data.status == 'assigned'
          && request.resource.data.revision == 0
          && request.resource.data.doneStepIds == []
          && request.resource.data.afterPhoto == null
          && request.resource.data.reviewNote == null
          && homeCareIsPhoto(request.resource.data.beforePhoto, 'before')
          && request.resource.data.marks is list
          && request.resource.data.marks.size() <= 20
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt')
          && isServerTime('updatedAt')
          && homeCareEventExistsAfter(householdId, jobId, 0);

        // Who the caller is to this job is worked out once, and each kind of
        // change is then only a question about the fields — the rules stop at a
        // thousand expressions, and asking for the grant four times reaches it.
        allow update: if isServerTime('updatedAt')
          && homeCareMayChangeJob(householdId, jobId, resource.data,
               request.resource.data, changedKeys());

        allow delete: if canEdit(householdId, 'homeCare');

        function homeCareMayChangeJob(householdId, jobId, before, after, changed) {
          let edits = canEdit(householdId, 'homeCare');
          let works = edits
            || (before.helperId == ownMemberId(householdId)
                  && (hasOwnOnly(householdId, 'homeCare')
                        || canView(householdId, 'homeCare')));
          return (edits && homeCareIsDetailsEdit(householdId, before, after, changed))
            || (works && homeCareIsWork(householdId, jobId, before, after, changed))
            || (works && homeCareIsHandIn(householdId, jobId, before, after, changed))
            || (edits && homeCareIsReview(householdId, jobId, before, after, changed));
        }

        // What family changes while the job is still with the helper: its
        // details, never its status or its photos.
        function homeCareIsDetailsEdit(householdId, before, after, changed) {
          return before.status in ['assigned', 'inProgress', 'sentBack']
            && changed.hasOnly(
                 ['title', 'roomId', 'helperId', 'dueDate', 'note', 'productIds',
                  'steps', 'doneStepIds', 'updatedAt'])
            && homeCareHasJobDetails(householdId, after)
            && homeCareHasSomeStepsDone(after);
        }

        // Ticking steps, and starting (again) with the first tick.
        function homeCareIsWork(householdId, jobId, before, after, changed) {
          return changed.hasOnly(['doneStepIds', 'status', 'revision', 'updatedAt'])
            && homeCareHasSomeStepsDone(after)
            && ((after.status == before.status
                   && before.status in ['assigned', 'inProgress', 'sentBack']
                   && after.revision == before.revision)
                || (before.status in ['assigned', 'sentBack']
                      && after.status == 'inProgress'
                      && homeCareLogsTheChange(householdId, jobId, before, after)));
        }

        // Handing in: every step ticked and an after photo named for this
        // revision, so a second hand-in never reuses the first one's object.
        function homeCareIsHandIn(householdId, jobId, before, after, changed) {
          return changed.hasOnly(
                   ['doneStepIds', 'status', 'revision', 'afterPhoto', 'updatedAt'])
            && before.status in ['assigned', 'inProgress', 'sentBack']
            && after.status == 'submitted'
            && after.doneStepIds is list
            && after.doneStepIds.size() == before.steps.size()
            && homeCareIsPhoto(after.afterPhoto, 'after-' + string(after.revision))
            && homeCareLogsTheChange(householdId, jobId, before, after);
        }

        // Approving, or sending back with a note the helper will read.
        function homeCareIsReview(householdId, jobId, before, after, changed) {
          return before.status == 'submitted'
            && homeCareLogsTheChange(householdId, jobId, before, after)
            && ((after.status == 'approved'
                   && changed.hasOnly(['status', 'revision', 'updatedAt']))
                || (after.status == 'sentBack'
                      && changed.hasOnly(['status', 'revision', 'reviewNote', 'updatedAt'])
                      && homeCareIsName(after.reviewNote, 500)));
        }

        function homeCareHasSomeStepsDone(after) {
          return after.doneStepIds is list
            && after.doneStepIds.size() <= after.steps.size();
        }

        function homeCareLogsTheChange(householdId, jobId, before, after) {
          return after.revision == before.revision + 1
            && homeCareEventExistsAfter(householdId, jobId, after.revision);
        }
      }

      // The job's history: one event per status change, named by the revision
      // it moved the job to, written in the same batch as that change and never
      // rewritten (home-care ADR-0001).
      match /homeCareJobs/{jobId}/events/{eventId} {
        allow read: if homeCareCanSeeJob(householdId, homeCareJobData(householdId, jobId));

        allow create: if request.resource.data.keys().hasOnly(['status', 'by', 'note', 'at'])
          && isOwnMember(householdId, request.resource.data.by)
          && isServerTime('at')
          && homeCareMatchesTheJobAfter(householdId, jobId, eventId);

        allow update: if false;

        allow delete: if canEdit(householdId, 'homeCare');

        // Who may write the change is the job rule's to say, in the same batch;
        // this only holds the event to the change. An event for a revision the
        // job is not at, or a status it does not have, has no job write that
        // could have allowed it.
        function homeCareMatchesTheJobAfter(householdId, jobId, eventId) {
          let job = getAfter(
            /databases/$(database)/documents/households/$(householdId)/homeCareJobs/$(jobId)
          ).data;
          return job.revision == int(eventId)
            && job.status == request.resource.data.status
            && request.resource.data.note == (job.status == 'sentBack' ? job.reviewNote : null);
        }
      }

      function homeCareJobData(householdId, jobId) {
        return get(
          /databases/$(database)/documents/households/$(householdId)/homeCareJobs/$(jobId)
        ).data;
      }

      function homeCareEventExistsAfter(householdId, jobId, revision) {
        return existsAfter(
          /databases/$(database)/documents/households/$(householdId)/homeCareJobs/$(jobId)/events/$(string(revision))
        );
      }

      function homeCareCanSeeJob(householdId, job) {
        return canView(householdId, 'homeCare')
          || (hasOwnOnly(householdId, 'homeCare')
                && job.helperId == ownMemberId(householdId));
      }

      // Family ticks and hands in too; otherwise only the job's own helper,
      // whether they hold `own` or `view`.
      function homeCareMayWorkJob(householdId, job) {
        return canEdit(householdId, 'homeCare')
          || ((hasOwnOnly(householdId, 'homeCare') || canView(householdId, 'homeCare'))
                && job.helperId == ownMemberId(householdId));
      }

      function homeCareHasJobDetails(householdId, job) {
        return homeCareIsName(job.title, 80)
          && isNonEmptyString(job.roomId)
          && isNonEmptyString(job.helperId)
          && exists(/databases/$(database)/documents/households/$(householdId)/members/$(job.helperId))
          && job.dueDate is string
          && job.dueDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && (job.note == null || homeCareIsName(job.note, 500))
          && job.productIds is list && job.productIds.size() <= 20
          && job.steps is list && job.steps.size() > 0 && job.steps.size() <= 30;
      }

      function homeCareIsPhoto(photo, photoId) {
        return photo is map
          && photo.keys().hasOnly(['photoId', 'width', 'height'])
          && photo.photoId == photoId
          && photo.width is int && photo.width > 0
          && photo.height is int && photo.height > 0;
      }

      function homeCareIsName(value, longest) {
        return value is string && value.size() > 0 && value.size() <= longest;
      }

      function homeCareIsOptionalText(value) {
        return value == null || homeCareIsName(value, 200);
      }

      function homeCareIsRoomKind(kind) {
        return kind in ['kitchen', 'lounge', 'dining', 'bedroom', 'kidsRoom',
                        'bathroom', 'laundry', 'office', 'outside', 'garage', 'other'];
      }

      function homeCareIsProduct(product) {
        return homeCareIsName(product.name, 60)
          && product.kind in ['bleach', 'ammonia', 'acidic', 'alcohol', 'peroxide',
                              'ovenCleaner', 'drainCleaner', 'disinfectant',
                              'allPurpose', 'dishSoap', 'bicarbonate', 'polish',
                              'floorCleaner', 'other']
          && homeCareIsOptionalText(product.whereKept)
          && homeCareIsOptionalText(product.note)
          && product.keepFromChildren is bool
          && product.keepFromPets is bool;
      }

      // ==== rules/firestore/household/household.rules ====
      // Every member reads it, and so does a kid device: the name, the zone that
      // makes "today" the household's today, and the `kids` map its own access is
      // worked out from (accounts ADR-0003, ADR-0004).
      allow read: if isInHousehold(householdId);

      // Created by `createHousehold`; the membership map is written only by
      // Functions, which is why there is no client write that touches it.
      allow create, delete: if false;

      allow update: if isAdmin(householdId)
        && ((onlyChanged(['name', 'timeZone'])
              && isNonEmptyString(request.resource.data.name)
              && isNonEmptyString(request.resource.data.timeZone))
            || isFinishingSetup());

      // The invite step `createHousehold` opens (household ADR-0003). An admin
      // may close it — done or skipped — and never open it again.
      function isFinishingSetup() {
        return onlyChanged(['pendingSetupStep'])
          && request.resource.data.pendingSetupStep == null;
      }

      match /members/{memberId} {
        // A kid device reads its own profile and nobody else's — not the list
        // (accounts ADR-0003).
        allow read: if isMember(householdId) || isKidAs(householdId, memberId);

        // An admin adds a profile for somebody whether or not they will ever
        // sign in. It starts unclaimed; claiming is `redeemInvite` alone.
        allow create: if isAdmin(householdId)
          && request.resource.data.keys().hasOnly(
               ['displayName', 'color', 'role', 'birthday', 'access', 'claimedBy',
                'createdAt'])
          && isNonEmptyString(request.resource.data.displayName)
          && isNonEmptyString(request.resource.data.color)
          && isRole(request.resource.data.role)
          && isBirthday(request.resource.data.get('birthday', null))
          && isGrant(request.resource.data.get('access', null))
          && request.resource.data.claimedBy == null
          && isServerTime('createdAt');

        // A claimed member's role also lives in the household's uid→role map,
        // and one write cannot touch two documents — so changing it is
        // `setMemberRole`, and here it may only change while nobody holds it.
        // `get('birthday', null)` rather than a bare read: every profile
        // written before the field existed has no key at all, and a rule that
        // reads a missing key refuses the write (BE-10).
        //
        // The grant follows the same rule as the role, for the same reason: a
        // claimed member's lives in the household document too, so changing
        // it is `setMemberAccess` (household ADR-0003).
        allow update: if isAdmin(householdId)
          && onlyChanged(['displayName', 'color', 'role', 'birthday', 'access'])
          && isNonEmptyString(request.resource.data.displayName)
          && isNonEmptyString(request.resource.data.color)
          && isRole(request.resource.data.role)
          && isBirthday(request.resource.data.get('birthday', null))
          && isGrant(request.resource.data.get('access', null))
          && (resource.data.claimedBy == null
                || (didNotChange('role') && !changedKeys().hasAny(['access'])));

        // Removing a profile detaches whoever claimed it: `removeMember`.
        allow delete: if false;
      }

      // ==== rules/firestore/household/kid_devices.rules ====
      // ---- kid devices (accounts ADR-0003) ----
      // Which devices are signed in as which kid, for the parents who can end
      // them. Written only by the kid sign-in callables and `removeMember`.
      match /kidDevices/{deviceUid} {
        allow read: if isAdmin(householdId);
        allow write: if false;
      }

      // ==== rules/firestore/household/live_location.rules ====
      // ---- live location (live-location ADR-0001, ADR-0002) ----
      //
      // The document id is the member id, and that is the whole authorisation
      // story. `isOwnMember` on the path means a member writes only their own
      // position; there is no field anybody could put somebody else's id into.
      // `hasClaimed`, not `isOwnMember`: a kid device acts as its profile
      // elsewhere, but sharing where somebody is stays a thing only a person
      // with their own login does (accounts ADR-0004).
      // It also means **an unclaimed profile cannot have a location at all**:
      // its `claimedBy` is null, no uid is null, so no caller anywhere can
      // create that document.
      //
      // An admin has no write here. Starting or extending somebody else's
      // sharing is the one thing this feature must not permit, and it is
      // refused by the path rather than by a check that could be got wrong.
      match /memberLocations/{memberId} {
        // Membership, and nothing about the window. A read rule comparing
        // `request.time` to document data fails the *whole* listener the
        // moment any one member's window closes, because Firestore evaluates a
        // query against every document in its result and a listener's bounds
        // are fixed when it opens. The window is enforced on write instead, and
        // the client reads a closed one as *not sharing* (live-location
        // ADR-0001).
        allow read: if isMember(householdId);

        allow create, update: if hasClaimed(householdId, memberId)
          && request.resource.data.keys().hasOnly(
               ['point', 'accuracyMetres', 'reportedAt', 'sharingUntil'])
          && request.resource.data.point is latlng
          && request.resource.data.accuracyMetres is int
          && request.resource.data.accuracyMetres >= 0
          && isServerTime('reportedAt')
          && isBoundedShare(request.resource.data.sharingUntil);

        // Stopping is deleting: nothing is left for the household to read
        // (live-location ADR-0002). An admin may clear the pin a removed
        // member's dead phone left behind — a delete only ever removes what
        // somebody can see, never reveals it.
        allow delete: if hasClaimed(householdId, memberId)
          || isAdmin(householdId);

        // The window has to end, and it has to still be open. The first half is
        // what stops a share running for ever; the second is what actually ends
        // one, because a device whose window has passed can no longer say
        // anything. The number is mirrored in
        // `LiveLocationRepository.longestShare`.
        function isBoundedShare(sharingUntil) {
          return sharingUntil is timestamp
            && sharingUntil > request.time
            && sharingUntil < request.time + duration.value(4, 'h');
        }
      }

      // ==== rules/firestore/household/lunch_box.rules ====
      // ---- lunch boxes (lunch-box ADR-0001, ADR-0004) ----
      //
      // Everything here is the `lunch` grant: family always, a kid, helper or
      // carer as a parent chose (household ADR-0003). `own` is a kid reading the
      // one plan that is theirs; it writes nothing.
      //
      // The safety rule lives here, not only in the app (BE-20): every slot a
      // plan write changes is checked against the child's allergies, and against
      // nuts when nuts are ruled out for them by an allergy, their diet or their
      // school — `FoodRules.mustAvoid` in the app. A slot copies its item's
      // allergen codes, because rules cannot look an item up per slot; the
      // library is where those codes are kept honest.
      //
      // Free and premium (lunch-box ADR-0009, subscriptions ADR-0001): a free
      // household plans one child's week — the child `entitlement/freeChild` names
      // — and marks nothing eaten and ticks no prep list. Premium plans every
      // child, learns from what came home and keeps the Sunday prep list. Only
      // writes are gated: a household that lapses reads everything it made.

      // The household's library. Never deleted — put away instead — because past
      // weeks' eaten-or-not history names its items.
      match /lunchItems/{itemId} {
        allow read: if canView(householdId, 'lunch');

        allow create: if canEdit(householdId, 'lunch')
          && isLunchItem(request.resource.data)
          && request.resource.data.get('archived', false) == false
          && isOwnMember(householdId, request.resource.data.addedBy)
          && isServerTime('createdAt');

        // Its slot never moves: boxes hold it under that slot's key.
        allow update: if canEdit(householdId, 'lunch')
          && onlyChanged(['name', 'nameKey', 'allergens', 'prepAhead', 'prepNote', 'archived'])
          && isLunchItem(request.resource.data);

        allow delete: if false;
      }

      // One child's school week: `{childId}_{YYYY-Www}`. product-analytics counts
      // the first write of one as a plan made (its ADR-0001), so it is never
      // deleted — a week emptied out is still a week that was planned.
      match /lunchPlans/{planId} {
        allow read: if canView(householdId, 'lunch')
          || (hasOwnOnly(householdId, 'lunch') && isLunchPlanOf(planId, ownMemberId(householdId)));

        allow create: if canEdit(householdId, 'lunch')
          && isLunchPlan(planId, request.resource.data)
          && isLunchChild(householdId, request.resource.data.childId)
          && lunchPlansFor(householdId, request.resource.data.childId)
          && (request.resource.data.get('feedback', {}).size() == 0 || hasPremium(householdId))
          && lunchSlotsAreSafe(householdId, request.resource.data.childId,
               request.resource.data.get('slots', {}),
               request.resource.data.get('slots', {}).keys())
          && lunchFeedbackIsValid(householdId, request.resource.data.get('feedback', {}),
               request.resource.data.get('feedback', {}).keys());

        allow update: if canEdit(householdId, 'lunch')
          && onlyChanged(['slots', 'feedback'])
          && isLunchPlan(planId, request.resource.data)
          && lunchPlansFor(householdId, resource.data.childId)
          && (request.resource.data.get('feedback', {}) == resource.data.get('feedback', {})
                || hasPremium(householdId))
          && lunchSlotsAreSafe(householdId, resource.data.childId,
               request.resource.data.get('slots', {}),
               request.resource.data.get('slots', {}).diff(resource.data.get('slots', {})).affectedKeys())
          && lunchFeedbackIsValid(householdId, request.resource.data.get('feedback', {}),
               request.resource.data.get('feedback', {}).diff(resource.data.get('feedback', {})).affectedKeys());

        allow delete: if false;
      }

      // A go-to box for one child. Not food in a box yet: it is checked when it
      // is packed into a plan, and the app flags one that stops being safe.
      match /lunchFavourites/{favouriteId} {
        allow read: if canView(householdId, 'lunch');

        allow create: if canEdit(householdId, 'lunch')
          && request.resource.data.keys().hasOnly(['childId', 'name', 'picks', 'createdBy', 'createdAt'])
          && isLunchChild(householdId, request.resource.data.childId)
          && isLunchText(request.resource.data.name, 40)
          && isLunchFavouritePicks(request.resource.data.picks)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if canEdit(householdId, 'lunch')
          && onlyChanged(['name', 'picks'])
          && isLunchText(request.resource.data.name, 40)
          && isLunchFavouritePicks(request.resource.data.picks);

        allow delete: if canEdit(householdId, 'lunch');
      }

      // A week's Sunday prep ticks, one document per household week. Premium.
      match /lunchPrep/{week} {
        allow read: if canView(householdId, 'lunch');

        allow create, update: if canEdit(householdId, 'lunch')
          && hasPremium(householdId)
          && week.matches('^[0-9]{4}-W[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['done'])
          && request.resource.data.done is list
          && request.resource.data.done.size() <= 200;

        allow delete: if false;
      }

      function isLunchText(value, longest) {
        return value is string && value.size() > 0 && value.size() <= longest;
      }

      // The nine allergen codes are family-profiles' `Allergen`;
      // `lunch_vocabulary_matches_the_rules_test.dart` holds these lists and the
      // app's together.
      function isLunchAllergens(value) {
        return value is list
          && value.size() <= 9
          && value.hasOnly(['peanut', 'treeNut', 'milk', 'egg', 'wheat', 'soy', 'fish', 'shellfish', 'sesame']);
      }

      function isLunchItem(data) {
        return data.keys().hasOnly(
             ['name', 'nameKey', 'slot', 'allergens', 'prepAhead', 'prepNote', 'archived',
              'seedKey', 'addedBy', 'createdAt'])
          && isLunchText(data.name, 60)
          && data.nameKey is string && data.nameKey.size() > 0 && data.nameKey == data.nameKey.lower()
          && data.slot in ['main', 'fruit', 'veg', 'snack', 'treat']
          && isLunchAllergens(data.get('allergens', []))
          && data.get('prepAhead', false) is bool
          && (data.get('prepNote', null) == null || isLunchText(data.get('prepNote', null), 140))
          && data.get('archived', false) is bool
          && (data.get('seedKey', null) == null || isLunchText(data.get('seedKey', null), 60));
      }

      // What one compartment holds: the item, and a copy of its name and codes.
      function isLunchPick(pick) {
        return pick is map
          && pick.keys().hasOnly(['itemId', 'name', 'allergens'])
          && isLunchText(pick.itemId, 128)
          && isLunchText(pick.name, 60)
          && isLunchAllergens(pick.get('allergens', []));
      }

      function isLunchFavouritePicks(picks) {
        return picks is map
          && picks.size() > 0
          && picks.keys().hasOnly(['main', 'fruit', 'veg', 'snack', 'treat'])
          && (!('main' in picks) || isLunchPick(picks.main))
          && (!('fruit' in picks) || isLunchPick(picks.fruit))
          && (!('veg' in picks) || isLunchPick(picks.veg))
          && (!('snack' in picks) || isLunchPick(picks.snack))
          && (!('treat' in picks) || isLunchPick(picks.treat));
      }

      function isLunchPlanOf(planId, childId) {
        return childId is string && childId.size() > 0
          && planId.matches(childId + '_[0-9]{4}-W[0-9]{2}');
      }

      // The id is the child and the week; the three fields say the same and never
      // change afterwards.
      function isLunchPlan(planId, data) {
        return data.keys().hasOnly(['childId', 'week', 'weekStart', 'slots', 'feedback'])
          && data.childId is string
          && data.week is string && data.week.matches('^[0-9]{4}-W[0-9]{2}$')
          && planId == data.childId + '_' + data.week
          && data.weekStart is string && data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.get('slots', {}) is map
          && data.get('slots', {}).keys().hasOnly([
               '1_main', '1_fruit', '1_veg', '1_snack', '1_treat',
               '2_main', '2_fruit', '2_veg', '2_snack', '2_treat',
               '3_main', '3_fruit', '3_veg', '3_snack', '3_treat',
               '4_main', '4_fruit', '4_veg', '4_snack', '4_treat',
               '5_main', '5_fruit', '5_veg', '5_snack', '5_treat'])
          && data.get('feedback', {}) is map
          && data.get('feedback', {}).keys().hasOnly(['1', '2', '3', '4', '5']);
      }

      // Whether this household's plan may be written for this child: every child
      // with premium; without it, the one child `setChildProfile` recorded. A
      // household with no record has not marked a child since the record began,
      // so it is not held to one it never had.
      function lunchPlansFor(householdId, childId) {
        let freeChild = /databases/$(database)/documents/households/$(householdId)/entitlement/freeChild;
        return hasPremium(householdId)
          || !exists(freeChild)
          || get(freeChild).data.get('memberId', '') == childId;
      }

      // Lunches are planned for children: a member family profiles marks as one.
      function isLunchChild(householdId, childId) {
        return childId is string
          && exists(/databases/$(database)/documents/households/$(householdId)/familyProfiles/$(childId))
          && get(/databases/$(database)/documents/households/$(householdId)/familyProfiles/$(childId)).data.get('isChild', false) == true;
      }

      // ==== rules/firestore/household/lunch_box_checks.rules ====
      // ---- lunch boxes: the safety and what-came-home checks (lunch-box ADR-0001, ADR-0010) ----
      //
      // The functions `lunch_box.rules` calls on every plan write, apart so each
      // file stays one reading. Nothing here is a match.

      // The allergen codes that must stay out of this child's box: their fixed
      // allergies, and both nuts when nuts are ruled out for them — the rules'
      // copy of `FoodRules.mustAvoid`.
      function lunchAvoidFor(householdId, childId) {
        let profile = get(/databases/$(database)/documents/households/$(householdId)/familyProfiles/$(childId)).data;
        let allergens = profile.get('allergies', {}).keys();
        let isNutFree = allergens.hasAny(['peanut', 'treeNut'])
          || profile.get('diet', []).hasAny(['nutFree'])
          || lunchSchoolIsNutFree(householdId, profile.get('schoolId', null));
        return isNutFree ? allergens.concat(['peanut', 'treeNut']) : allergens;
      }

      // Only a school that exists makes a rule; a deleted one reads as no school,
      // as it does in the app (`FamilyRoster`).
      function lunchSchoolIsNutFree(householdId, schoolId) {
        return schoolId is string
          && exists(/databases/$(database)/documents/households/$(householdId)/schools/$(schoolId))
          && get(/databases/$(database)/documents/households/$(householdId)/schools/$(schoolId)).data.get('nutFree', false) == true;
      }

      // A well-formed pick with nothing the child must avoid, in as few
      // expressions as the check allows: Firestore stops a request at 1000, and a
      // plan write with its grant, child, premium and shape checks has room for
      // six of these (measured, lunch-box ADR-0010). The app writes one day — five
      // slots — at most per write for that reason.
      function lunchPickIsSafe(pick, avoid) {
        return pick.keys().hasOnly(['itemId', 'name', 'allergens'])
          && pick.itemId is string
          && pick.name is string && pick.name.size() > 0 && pick.name.size() <= 60
          && pick.get('allergens', []).hasOnly(['peanut', 'treeNut', 'milk', 'egg', 'wheat', 'soy', 'fish', 'shellfish', 'sesame'])
          && !pick.get('allergens', []).hasAny(avoid);
      }

      // Every slot this write changed, checked by name — rules cannot loop, and
      // slots it did not touch are not this write's to answer for.
      //
      // Each argument is bound once with `let` before the checks use it: an
      // argument that is an expression is otherwise worked out again at every use.
      function lunchSlotsAreSafe(householdId, childId, slots, changed) {
        let theSlots = slots;
        let theChanged = changed;
        return theChanged.size() == 0 || lunchChangedSlotsAreSafeFor(householdId, childId, theSlots, theChanged);
      }

      function lunchChangedSlotsAreSafeFor(householdId, childId, slots, changed) {
        let avoid = lunchAvoidFor(householdId, childId);
        return lunchChangedSlotsAreSafe(slots, changed, avoid);
      }

      function lunchChangedSlotsAreSafe(slots, changed, avoid) {
        return (!('1_main' in changed) || !('1_main' in slots) || lunchPickIsSafe(slots['1_main'], avoid))
          && (!('1_fruit' in changed) || !('1_fruit' in slots) || lunchPickIsSafe(slots['1_fruit'], avoid))
          && (!('1_veg' in changed) || !('1_veg' in slots) || lunchPickIsSafe(slots['1_veg'], avoid))
          && (!('1_snack' in changed) || !('1_snack' in slots) || lunchPickIsSafe(slots['1_snack'], avoid))
          && (!('1_treat' in changed) || !('1_treat' in slots) || lunchPickIsSafe(slots['1_treat'], avoid))
          && (!('2_main' in changed) || !('2_main' in slots) || lunchPickIsSafe(slots['2_main'], avoid))
          && (!('2_fruit' in changed) || !('2_fruit' in slots) || lunchPickIsSafe(slots['2_fruit'], avoid))
          && (!('2_veg' in changed) || !('2_veg' in slots) || lunchPickIsSafe(slots['2_veg'], avoid))
          && (!('2_snack' in changed) || !('2_snack' in slots) || lunchPickIsSafe(slots['2_snack'], avoid))
          && (!('2_treat' in changed) || !('2_treat' in slots) || lunchPickIsSafe(slots['2_treat'], avoid))
          && (!('3_main' in changed) || !('3_main' in slots) || lunchPickIsSafe(slots['3_main'], avoid))
          && (!('3_fruit' in changed) || !('3_fruit' in slots) || lunchPickIsSafe(slots['3_fruit'], avoid))
          && (!('3_veg' in changed) || !('3_veg' in slots) || lunchPickIsSafe(slots['3_veg'], avoid))
          && (!('3_snack' in changed) || !('3_snack' in slots) || lunchPickIsSafe(slots['3_snack'], avoid))
          && (!('3_treat' in changed) || !('3_treat' in slots) || lunchPickIsSafe(slots['3_treat'], avoid))
          && (!('4_main' in changed) || !('4_main' in slots) || lunchPickIsSafe(slots['4_main'], avoid))
          && (!('4_fruit' in changed) || !('4_fruit' in slots) || lunchPickIsSafe(slots['4_fruit'], avoid))
          && (!('4_veg' in changed) || !('4_veg' in slots) || lunchPickIsSafe(slots['4_veg'], avoid))
          && (!('4_snack' in changed) || !('4_snack' in slots) || lunchPickIsSafe(slots['4_snack'], avoid))
          && (!('4_treat' in changed) || !('4_treat' in slots) || lunchPickIsSafe(slots['4_treat'], avoid))
          && (!('5_main' in changed) || !('5_main' in slots) || lunchPickIsSafe(slots['5_main'], avoid))
          && (!('5_fruit' in changed) || !('5_fruit' in slots) || lunchPickIsSafe(slots['5_fruit'], avoid))
          && (!('5_veg' in changed) || !('5_veg' in slots) || lunchPickIsSafe(slots['5_veg'], avoid))
          && (!('5_snack' in changed) || !('5_snack' in slots) || lunchPickIsSafe(slots['5_snack'], avoid))
          && (!('5_treat' in changed) || !('5_treat' in slots) || lunchPickIsSafe(slots['5_treat'], avoid));
      }

      // What came home: a verdict for the box, optionally one per slot, marked in
      // the caller's own name at the server's time. A day taken back is gone.
      function lunchFeedbackIsValid(householdId, feedback, changed) {
        let theFeedback = feedback;
        let theChanged = changed;
        return theChanged.size() == 0 || lunchFeedbackDaysAreValid(householdId, theFeedback, theChanged);
      }

      function lunchFeedbackDaysAreValid(householdId, feedback, changed) {
        return lunchDayFeedbackIsValid(householdId, feedback, changed, '1')
          && lunchDayFeedbackIsValid(householdId, feedback, changed, '2')
          && lunchDayFeedbackIsValid(householdId, feedback, changed, '3')
          && lunchDayFeedbackIsValid(householdId, feedback, changed, '4')
          && lunchDayFeedbackIsValid(householdId, feedback, changed, '5');
      }

      function lunchDayFeedbackIsValid(householdId, feedback, changed, day) {
        return !(day in changed)
          || !(day in feedback)
          || (feedback[day] is map
              && feedback[day].keys().hasOnly(['verdict', 'items', 'by', 'at'])
              && feedback[day].verdict in ['ate', 'left']
              && feedback[day].get('items', {}) is map
              && feedback[day].get('items', {}).keys().hasOnly(['main', 'fruit', 'veg', 'snack', 'treat'])
              && feedback[day].get('items', {}).values().hasOnly(['ate', 'left'])
              && isOwnMember(householdId, feedback[day].by)
              && feedback[day].at == request.time);
      }

      // ==== rules/firestore/household/meal_planning.rules ====
      // ---- meal planning (meal-planning ADR-0001) ----

      // The library is what the household has typed before. `nameKey` is the
      // normalised name the app asks "have we had this before" with.
      //
      // The rule checks that it is present and lower-cased, and no more: the
      // normaliser also collapses runs of whitespace, and the rules language
      // has no way to express that. A wrong key is a duplicate in one
      // household's own library, not a way into anybody's data — so this is a
      // validation the client owns and the rules cannot (BE-03).
      match /meals/{mealId} {
        allow read: if canView(householdId, 'meals');

        allow create: if canEdit(householdId, 'meals')
          && request.resource.data.keys().hasOnly(
               ['name', 'nameKey', 'addedBy', 'createdAt'])
          && isNonEmptyString(request.resource.data.name)
          && isNormalisedKey(request.resource.data.nameKey)
          && isOwnMember(householdId, request.resource.data.addedBy)
          && isServerTime('createdAt');

        allow update: if canEdit(householdId, 'meals')
          && onlyChanged(['name', 'nameKey'])
          && isNonEmptyString(request.resource.data.name)
          && isNormalisedKey(request.resource.data.nameKey)
          && (isAdmin(householdId)
                || isOwnMember(householdId, resource.data.addedBy));

        allow delete: if isAdmin(householdId)
          || (canEdit(householdId, 'meals')
                && isOwnMember(householdId, resource.data.addedBy));

        function isNormalisedKey(value) {
          return value is string && value.size() > 0 && value == value.lower();
        }
      }

      // One document is one week, keyed by its Monday. The plan has no owner:
      // any member fills, changes or clears any slot (meal-planning ADR-0001).
      match /mealPlans/{weekStart} {
        allow read: if canView(householdId, 'meals');

        allow create, update: if canEdit(householdId, 'meals')
          && request.resource.data.keys().hasOnly(['slots'])
          && request.resource.data.slots is map
          && request.resource.data.slots.size() <= 21;

        allow delete: if isAdmin(householdId);
      }

      // ==== rules/firestore/household/nanny_hub.rules ====
      // ---- nanny hub (nanny-hub ADR-0001, ADR-0002, ADR-0003) ----
      //
      // Everything a carer needs for one shift, gated on the `nannyHub` grant
      // alone (household ADR-0003): `view` reads the hub, `edit` writes it — a
      // parent authoring the cards, a carer keeping the shift's log. The child's
      // allergies and medication are not here: they are read from family
      // profiles, under that feature's own grants (family-profiles ADR-0002).
      // Every record is stamped with the member who wrote it, never a name
      // somebody typed (BE-03).

      // One card per child, keyed by the child's member id, so there is no field
      // to point at somebody else. Written a section at a time as a merge, so the
      // whole document is judged as it will be after the write.
      match /nannyChildCards/{memberId} {
        allow read: if canView(householdId, 'nannyHub');

        allow create: if canEdit(householdId, 'nannyHub')
          && nannyMemberExists(householdId, memberId)
          && isNannyChildCard(request.resource.data)
          && isOwnMember(householdId, request.resource.data.updatedBy)
          && isServerTime('updatedAt');

        allow update: if canEdit(householdId, 'nannyHub')
          && isNannyChildCard(request.resource.data)
          && isOwnMember(householdId, request.resource.data.updatedBy)
          && isServerTime('updatedAt');

        allow delete: if canEdit(householdId, 'nannyHub');
      }

      // The people to call: parents, backup adults, the doctor, the hospital. One
      // document each, so two parents adding two numbers never overwrite each
      // other.
      match /nannyContacts/{contactId} {
        allow read: if canView(householdId, 'nannyHub');

        allow create: if canEdit(householdId, 'nannyHub')
          && request.resource.data.keys().hasOnly(
               ['name', 'kind', 'phone', 'note', 'createdBy', 'createdAt'])
          && isNannyContact(request.resource.data)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if canEdit(householdId, 'nannyHub')
          && onlyChanged(['name', 'kind', 'phone', 'note'])
          && isNannyContact(request.resource.data);

        allow delete: if canEdit(householdId, 'nannyHub');
      }

      // The home's own facts for the emergency sheet: where it is and the medical
      // aid. One document, always called `sheet`.
      match /nannyHome/{sheetId} {
        allow read: if canView(householdId, 'nannyHub');

        allow create, update: if canEdit(householdId, 'nannyHub')
          && sheetId == 'sheet'
          && request.resource.data.keys().hasOnly(
               ['address', 'medicalAidScheme', 'medicalAidPlan', 'medicalAidNumber',
                'updatedBy', 'updatedAt'])
          && isNannyOptionalText(request.resource.data.get('address', null), 300)
          && isNannyOptionalText(request.resource.data.get('medicalAidScheme', null), 80)
          && isNannyOptionalText(request.resource.data.get('medicalAidPlan', null), 80)
          && isNannyOptionalText(request.resource.data.get('medicalAidNumber', null), 40)
          && isOwnMember(householdId, request.resource.data.updatedBy)
          && isServerTime('updatedAt');

        allow delete: if false;
      }

      // Where things are, each with an optional photo whose bytes are in Storage
      // at `households/{h}/nannyHub/{photoId}` (nanny-hub ADR-0003).
      match /nannyGuide/{spotId} {
        allow read: if canView(householdId, 'nannyHub');

        allow create: if canEdit(householdId, 'nannyHub')
          && request.resource.data.keys().hasOnly(
               ['title', 'note', 'photoId', 'createdBy', 'createdAt'])
          && isNannyGuideSpot(request.resource.data)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if canEdit(householdId, 'nannyHub')
          && onlyChanged(['title', 'note', 'photoId'])
          && isNannyGuideSpot(request.resource.data);

        allow delete: if canEdit(householdId, 'nannyHub');
      }

      match /nannyRules/{ruleId} {
        allow read: if canView(householdId, 'nannyHub');

        allow create: if canEdit(householdId, 'nannyHub')
          && request.resource.data.keys().hasOnly(['text', 'createdBy', 'createdAt'])
          && isNannyText(request.resource.data.text, 300)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if canEdit(householdId, 'nannyHub')
          && onlyChanged(['text'])
          && isNannyText(request.resource.data.text, 300);

        allow delete: if canEdit(householdId, 'nannyHub');
      }

      // One checklist per part of a shift, named by the moment it is for — the
      // hub's own, not a todos routine, because it is ticked per shift rather than
      // per date (nanny-hub ADR-0001).
      match /nannyChecklists/{moment} {
        allow read: if canView(householdId, 'nannyHub');

        allow create, update: if canEdit(householdId, 'nannyHub')
          && moment in ['arrival', 'afterSchool', 'dinner', 'bedtime', 'beforeLeaving']
          && request.resource.data.keys().hasOnly(['items', 'updatedBy', 'updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 20
          && isOwnMember(householdId, request.resource.data.updatedBy)
          && isServerTime('updatedAt');

        allow delete: if canEdit(householdId, 'nannyHub');
      }

      // A shift has an explicit start and end (nanny-hub ADR-0002). A client
      // starts one — for themselves, or family for a carer — and ticks its
      // checklists while it is open. Only `endNannyShift` ends one, because the
      // end writes the summary the parents read in the same transaction.
      match /nannyShifts/{shiftId} {
        allow read: if canView(householdId, 'nannyHub');

        allow create: if canEdit(householdId, 'nannyHub')
          && request.resource.data.keys().hasOnly(
               ['carerMemberId', 'startedBy', 'startedAt', 'endedAt', 'endedBy',
                'status', 'ticks'])
          && request.resource.data.status == 'open'
          && request.resource.data.endedAt == null
          && request.resource.data.endedBy == null
          && request.resource.data.ticks == {}
          && isOwnMember(householdId, request.resource.data.startedBy)
          && (request.resource.data.carerMemberId == request.resource.data.startedBy
                || isFamily(householdId))
          && nannyMemberExists(householdId, request.resource.data.carerMemberId)
          && isServerTime('startedAt');

        allow update: if canEdit(householdId, 'nannyHub')
          && resource.data.status == 'open'
          && onlyChanged(['ticks'])
          && request.resource.data.ticks is map
          && request.resource.data.ticks.size() <= 100;

        allow delete: if false;

        // The handover log: what happened, when, to whom, with a photo. Written
        // only while the shift is open, and changed only by whoever wrote it.
        match /entries/{entryId} {
          allow read: if canView(householdId, 'nannyHub');

          allow create: if canEdit(householdId, 'nannyHub')
            && isNannyShiftOpen(householdId, shiftId)
            && request.resource.data.keys().hasOnly(
                 ['kind', 'note', 'mood', 'childIds', 'photoId', 'at', 'byMemberId',
                  'createdAt'])
            && isNannyEntry(request.resource.data)
            && isOwnMember(householdId, request.resource.data.byMemberId)
            && isServerTime('createdAt');

          allow update: if canEdit(householdId, 'nannyHub')
            && isNannyShiftOpen(householdId, shiftId)
            && isOwnMember(householdId, resource.data.byMemberId)
            && onlyChanged(['kind', 'note', 'mood', 'childIds', 'photoId', 'at'])
            && isNannyEntry(request.resource.data);

          allow delete: if canEdit(householdId, 'nannyHub')
            && isNannyShiftOpen(householdId, shiftId)
            && isOwnMember(householdId, resource.data.byMemberId);
        }
      }

      // Written by `endNannyShift` only, and read by whoever reads the hub. The
      // notifications feature delivers it; no client writes one (nanny-hub
      // ADR-0002).
      match /nannyShiftSummaries/{shiftId} {
        allow read: if canView(householdId, 'nannyHub');
        allow write: if false;
      }

      function nannyMemberExists(householdId, memberId) {
        return exists(/databases/$(database)/documents/households/$(householdId)/members/$(memberId));
      }

      function isNannyShiftOpen(householdId, shiftId) {
        return get(/databases/$(database)/documents/households/$(householdId)/nannyShifts/$(shiftId)).data.status == 'open';
      }

      function isNannyText(value, longest) {
        return isNonEmptyString(value) && value.size() <= longest;
      }

      function isNannyOptionalText(value, longest) {
        return value == null || isNannyText(value, longest);
      }

      // A photo's object name in Storage. Generated by the app; bounded so a
      // field cannot be used to smuggle a path.
      function isNannyPhotoId(value) {
        return value == null
          || (value is string && value.matches('^[A-Za-z0-9_-]{8,64}$'));
      }

      // The limits are `NannyLimits` in the app; `nanny_limits_match_the_rules_test`
      // reads this file and fails when the two drift apart.
      function isNannyChildCard(data) {
        return data.keys().hasOnly(
             ['routines', 'comfortItems', 'settling', 'goodToKnow', 'photoId',
              'updatedBy', 'updatedAt'])
          && data.get('routines', []) is list
          && data.get('routines', []).size() <= 12
          && data.get('comfortItems', []) is list
          && data.get('comfortItems', []).size() <= 30
          && isNannyOptionalText(data.get('settling', null), 600)
          && isNannyOptionalText(data.get('goodToKnow', null), 600)
          && isNannyPhotoId(data.get('photoId', null));
      }

      function isNannyContact(data) {
        return isNannyText(data.name, 60)
          && data.kind in ['parent', 'backup', 'doctor', 'hospital', 'other']
          && data.phone is string
          && data.phone.matches('^[+0-9 ()-]{3,20}$')
          && isNannyOptionalText(data.get('note', null), 200);
      }

      function isNannyGuideSpot(data) {
        return isNannyText(data.title, 80)
          && isNannyOptionalText(data.get('note', null), 400)
          && isNannyPhotoId(data.get('photoId', null));
      }

      // An entry says something: a note, a mood or a photo. Its time may be set
      // back — a nap logged when it ended — but never into the future.
      function isNannyEntry(data) {
        return data.kind in ['meal', 'nap', 'nappy', 'mood', 'incident', 'medicine', 'note']
          && isNannyOptionalText(data.get('note', null), 500)
          && (data.get('mood', null) == null
                || data.mood in ['happy', 'calm', 'tired', 'upset', 'unwell'])
          && data.childIds is list
          && data.childIds.size() <= 10
          && isNannyPhotoId(data.get('photoId', null))
          && (data.get('note', null) != null
                || data.get('mood', null) != null
                || data.get('photoId', null) != null)
          && data.at is timestamp
          && data.at <= request.time + duration.value(5, 'm');
      }

      // ==== rules/firestore/household/subscriptions.rules ====
      // ---- subscriptions (subscriptions ADR-0001) ----
      //
      // What the household may do. Everybody in it reads it — a helper who reaches
      // a premium feature is told why it is closed, and a kid's tablet shows what
      // the family has — because it says nothing about any one person beyond who
      // manages the plan. Nobody writes it: only a Function does, after a store
      // has vouched for a purchase, so no client can give itself premium.

      match /entitlement/{document} {
        allow read: if isInHousehold(householdId);
        allow write: if false;
      }

      // ==== rules/firestore/household/todos.rules ====
      // ---- todos (todos ADR-0001, ADR-0002) ----

      match /tasks/{taskId} {
        // `own` is a helper's or a kid's own chores: what lists them as an
        // assignee. The client asks for exactly those (`array-contains`),
        // because a rule is not a filter (household ADR-0003).
        allow read: if canView(householdId, 'todos')
          || (hasOwnOnly(householdId, 'todos')
                && ownMemberId(householdId) in resource.data.assigneeIds);

        allow create: if canEdit(householdId, 'todos')
          && request.resource.data.keys().hasOnly(
               ['title', 'note', 'dueDate', 'recurrence', 'assigneeIds',
                'createdBy', 'routineId', 'createdAt', 'points', 'needsApproval'])
          && isNonEmptyString(request.resource.data.title)
          && isNonEmptyString(request.resource.data.dueDate)
          && request.resource.data.assigneeIds is list
          && choreStarsAreValid(request.resource.data)
          && (isFamily(householdId) || !choreCarriesStars(request.resource.data))
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        // Anybody may retitle, reschedule or reassign what they created; an
        // admin may do it to anything. Completing is not an edit — it is its
        // own document (todos ADR-0002). What a chore is worth is family's alone
        // to change (todos ADR-0003).
        allow update: if canEdit(householdId, 'todos')
          && onlyChanged(
               ['title', 'note', 'dueDate', 'recurrence', 'assigneeIds', 'routineId',
                'points', 'needsApproval'])
          && isNonEmptyString(request.resource.data.title)
          && isNonEmptyString(request.resource.data.dueDate)
          && choreStarsAreValid(request.resource.data)
          && (isFamily(householdId) || choreStarsUnchanged())
          && (isAdmin(householdId)
                || isOwnMember(householdId, resource.data.createdBy));

        allow delete: if isAdmin(householdId)
          || (canEdit(householdId, 'todos')
                && isOwnMember(householdId, resource.data.createdBy));
      }

      // A routine's schedule moves every task in it, which is why only an admin
      // may write one (todos ADR-0001).
      match /routines/{routineId} {
        // Names and schedules, so a task in a routine lands on the right day.
        // `own` reads them too: a helper's or a kid's own chore follows its
        // routine's schedule, and a routine says nothing a chore does not
        // (accounts ADR-0004).
        allow read: if canView(householdId, 'todos') || hasOwnOnly(householdId, 'todos');

        allow create: if isAdmin(householdId)
          && request.resource.data.keys().hasOnly(
               ['name', 'firstDate', 'recurrence', 'defaultAssigneeIds', 'color',
                'createdBy', 'createdAt'])
          && isNonEmptyString(request.resource.data.name)
          && isNonEmptyString(request.resource.data.firstDate)
          && isOwnMember(householdId, request.resource.data.createdBy)
          && isServerTime('createdAt');

        allow update: if isAdmin(householdId)
          && onlyChanged(['name', 'firstDate', 'recurrence', 'defaultAssigneeIds', 'color'])
          && isNonEmptyString(request.resource.data.name)
          && isNonEmptyString(request.resource.data.firstDate);

        allow delete: if isAdmin(householdId);
      }

      // One occurrence of one task, done. The document id is `{taskId}_{date}`,
      // which is what makes completing the same occurrence twice the same write
      // and stops a completion being filed against a different day (BE-06).
      match /taskCompletions/{completionId} {
        allow read: if canView(householdId, 'todos')
          || (hasOwnOnly(householdId, 'todos')
                && resource.data.completedFor == ownMemberId(householdId));

        allow create, update: if (canEdit(householdId, 'todos')
                                    || hasOwnOnly(householdId, 'todos'))
          && request.resource.data.keys().hasOnly(
               ['taskId', 'occurrenceDate', 'completedBy', 'completedFor', 'completedAt'])
          && completionId ==
               request.resource.data.taskId + '_' + request.resource.data.occurrenceDate
          && isOwnMember(householdId, request.resource.data.completedBy)
          && isServerTime('completedAt')
          && mayCompleteFor(
               householdId,
               request.resource.data.taskId,
               request.resource.data.completedFor);

        allow delete: if canEdit(householdId, 'todos')
          || (hasOwnOnly(householdId, 'todos')
                && resource.data.completedFor == ownMemberId(householdId));

        // An admin completes on anybody's behalf; everybody else completes only
        // what is theirs, or what is for anyone (household ADR-0001). With
        // `own`, "for anyone" is not theirs: they cannot even see it
        // (household ADR-0003).
        function mayCompleteFor(householdId, taskId, forMemberId) {
          return isAdmin(householdId)
            || (isOwnMember(householdId, forMemberId)
                  && ((taskAssignees(householdId, taskId).size() == 0
                          && !hasOwnOnly(householdId, 'todos'))
                        || forMemberId in taskAssignees(householdId, taskId)));
        }

        function taskAssignees(householdId, taskId) {
          return get(
            /databases/$(database)/documents/households/$(householdId)/tasks/$(taskId)
          ).data.assigneeIds;
        }
      }
    }

    // Everything not named above (BE-05).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
