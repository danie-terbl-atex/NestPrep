// ---- avatars: a member's pictures (avatars ADR-0001) ----
//
// Authorised live from Firestore, because a kid device holds no household
// claim and a look is as public as a name: anybody in the household sees
// them. A picture is content-addressed and never replaced; family puts one up
// for anyone, a member for themselves. Keepsakes and every delete are the
// Functions' alone.
function avatarsHousehold(householdId) {
  return firestore.get(/databases/(default)/documents/households/$(householdId)).data;
}

function avatarsIsInHousehold(householdId) {
  let household = avatarsHousehold(householdId);
  return request.auth != null
    && (household.members.get(request.auth.uid, '') != ''
        || household.get('kids', {}).get(request.auth.uid, '') != '');
}

function avatarsActsFor(householdId, memberId) {
  let household = avatarsHousehold(householdId);
  return request.auth != null
    && (household.members.get(request.auth.uid, '') in ['admin', 'parent', 'member']
        || household.get('profiles', {}).get(request.auth.uid, '') == memberId
        || household.get('kids', {}).get(request.auth.uid, '') == memberId);
}

function avatarsIsUpload(maxBytes) {
  return request.resource.contentType == 'image/jpeg'
    && request.resource.size <= maxBytes
    && isStampedWithTheCaller();
}

match /households/{householdId}/avatars/{memberId}/{fileName} {
  allow get: if avatarsIsInHousehold(householdId);
  allow list: if false;

  allow create: if resource == null
    && fileName.matches('[0-9a-f]{32}[.]jpg')
    && avatarsIsUpload(512 * 1024)
    && avatarsActsFor(householdId, memberId);

  allow update, delete: if false;
}

match /households/{householdId}/avatars/{memberId}/inbox/{fileName} {
  allow get: if avatarsIsInHousehold(householdId);
  allow list: if false;

  allow create: if resource == null
    && fileName.matches('[A-Za-z0-9_-]{8,64}[.]jpg')
    && avatarsIsUpload(2 * 1024 * 1024)
    && avatarsActsFor(householdId, memberId);

  allow update, delete: if false;
}

match /households/{householdId}/avatars/{memberId}/keepsakes/{fileName} {
  allow get: if avatarsIsInHousehold(householdId);
  allow list, write: if false;
}
