// ---- a household's own recipe photos (recipes ADR-0007) ----
// Authorised live from Firestore: `meals` is not on the token. Premium is the
// callable's check, because an entitlement read would be a third cross-service
// read and refuse a shift-only carer.
match /households/{householdId}/recipePhotos/{recipeId}/{fileName} {
  function householdRecipePhotosHousehold() {
    return firestore.get(/databases/(default)/documents/households/$(householdId)).data;
  }

  function householdRecipePhotosMemberLevel() {
    let household = householdRecipePhotosHousehold();
    let role = household.members.get(request.auth.uid, '');
    let grant = household.get('access', {}).get(request.auth.uid, null);
    return role in ['admin', 'parent', 'member'] ? 'edit'
      : role == '' ? 'none'
      : grant != null ? grant.get('meals', 'none')
      : (role == 'helper' ? 'edit' : 'none');
  }

  function householdRecipePhotosKidLevel() {
    let memberId = householdRecipePhotosHousehold().get('kids', {}).get(request.auth.uid, '');
    let profile = memberId == ''
      ? null
      : firestore.get(/databases/(default)/documents/households/$(householdId)/members/$(memberId)).data;
    return profile != null && profile.role == 'kid'
      ? profile.get('access', {}).get('meals', 'none')
      : 'none';
  }

  function isAHouseholdRecipePhoto() {
    return recipeId.matches('own-[0-9a-f]{20}')
      && fileName.matches('[A-Za-z0-9_-]{8,64}-(card|hero)[.]jpg')
      && request.resource.contentType == 'image/jpeg'
      && request.resource.size <= 2 * 1024 * 1024
      && isStampedWithTheCaller();
  }

  allow get: if request.auth != null
    && isOnShiftIfShiftOnly(householdId)
    && (householdRecipePhotosMemberLevel() in ['view', 'edit']
          || householdRecipePhotosKidLevel() in ['view', 'edit']);

  allow list: if false;

  allow create: if request.auth != null
    && resource == null
    && isOnShiftIfShiftOnly(householdId)
    && isAHouseholdRecipePhoto()
    && householdRecipePhotosMemberLevel() == 'edit';

  allow update: if false;

  allow delete: if request.auth != null
    && isOnShiftIfShiftOnly(householdId)
    && householdRecipePhotosMemberLevel() == 'edit';
}
