// ---- live location (live-location ADR-0001, ADR-0003, ADR-0004) ----
//
// The document id is the member id, so `isOwnMember` on the path is the whole
// authorisation story: nobody can write somebody else's position, and an
// admin's only power is delete.
match /memberLocations/{memberId} {
  // No expiry check here: Firestore fails a whole listener when one document
  // in it is denied, and a listener's bounds are fixed when it opens. The
  // window is enforced on write; the client reads a closed one as not sharing.
  allow read: if canView(householdId, 'location');

  allow create, update: if isOwnMember(householdId, memberId)
    && request.resource.data.keys().hasOnly(
         ['point', 'accuracyMetres', 'reportedAt', 'sharingUntil', 'mode',
          'batteryPercent', 'charging', 'motion'])
    && request.resource.data.point is latlng
    && request.resource.data.accuracyMetres is int
    && request.resource.data.accuracyMetres >= 0
    && isServerTime('reportedAt')
    && isLiveLocationDevice(request.resource.data)
    && isLiveLocationLease(householdId, request.resource.data)
    && isLiveLocationPaced();

  allow delete: if isOwnMember(householdId, memberId) || isAdmin(householdId);

  function isLiveLocationDevice(data) {
    return (!('batteryPercent' in data)
            || (data.batteryPercent is int
                && data.batteryPercent >= 0 && data.batteryPercent <= 100))
      && (!('charging' in data) || data.charging is bool)
      && (!('motion' in data)
          || data.motion in ['still', 'onFoot', 'cycling', 'driving', 'unknown']);
  }

  // A window share ends within four hours, mirrored in
  // `LiveLocationRepository.longestShare`. Continuous sharing is premium and a
  // lease the device renews on every write, so a phone that dies stops
  // reading as anywhere within a day (live-location ADR-0003). Installed
  // phase-1 apps write no `mode`, which is a window.
  function isLiveLocationLease(householdId, data) {
    let until = data.sharingUntil;
    let mode = data.get('mode', 'window');
    return until is timestamp
      && until > request.time
      && ((mode == 'window' && until < request.time + duration.value(4, 'h'))
          || (mode == 'continuous'
              && until < request.time + duration.value(25, 'h')
              && hasPremium(householdId)));
  }

  // Ten seconds between writes caps a runaway client's bill. Switching
  // between a window and continuous is a deliberate tap, so it is never held.
  function isLiveLocationPaced() {
    return resource == null
      || request.resource.data.get('mode', 'window') != resource.data.get('mode', 'window')
      || request.time > resource.data.reportedAt + duration.value(10, 's');
  }
}
