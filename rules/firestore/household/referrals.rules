// ---- referrals: give a month, get a month (subscriptions ADR-0002) ----
//
// The household's own code, the lines of every referral it took part in,
// and the free months it was given. Family reads them — like buying,
// referring is the family's, so a helper, carer or kid sees none of it.
// Nobody writes them from a client: a code, a referral's progress and a
// month of premium are all written by Functions alone, so no phone can
// give itself a month.

match /referral/{document} {
  allow read: if isFamily(householdId);
  allow write: if false;
}

match /referralHistory/{entryId} {
  allow read: if isFamily(householdId);
  allow write: if false;
}

match /premiumGrants/{grantId} {
  allow read: if isFamily(householdId);
  allow write: if false;
}
