// ---- lunch-box V2: kid picks (lunch-box ADR-0008) ----
//
// A parent approves two or three options per compartment per day; the child
// chooses one, on their own device or a parent's phone. Options are refused
// here if they are not safe for the child, with the plan's own avoid set
// (`lunchAvoidFor`, lunch_box.rules). The child's choice is written into
// their plan: the second `match /lunchPlans` below lets a caller whose lunch
// grant is `own` change one slot of their own plan, only to one of that
// slot's approved options — and still only when it is safe for them. A write
// is allowed when any matching statement allows it, so lunch_box.rules is
// untouched and still governs everybody else.
//
// Every check here looks at one day, or one slot, never all twenty-five:
// the rules evaluate at most a thousand expressions a request, and a
// twenty-five-slot sweep of option lists costs more than that. So a parent's
// write says which day it changed (`editedDay`), and a child's choice says
// which slot (`chosenKey`), and the rules hold the write to exactly that.

// `{childId}_{YYYY-Www}` — the plan's own id.
match /lunchChoices/{choiceId} {
  allow read: if canView(householdId, 'lunch')
    || lunchKidOwnsWeek(householdId, choiceId);

  allow create: if resource == null
    && canEdit(householdId, 'lunch')
    && isLunchChoices(choiceId, request.resource.data)
    && request.resource.data.get('chosen', {}).size() == 0
    && request.resource.data.get('options', {}).keys()
         .hasOnly(lunchDayKeys(request.resource.data.editedDay))
    && isLunchChild(householdId, request.resource.data.childId)
    && isOwnMember(householdId, request.resource.data.updatedBy)
    && isServerTime('updatedAt')
    && lunchOptionsAreSafe(householdId, request.resource.data.childId,
         request.resource.data.get('options', {}),
         request.resource.data.get('options', {}).keys(),
         request.resource.data.editedDay);

  allow update: if resource != null
    && canEdit(householdId, 'lunch')
    && onlyChanged(['options', 'chosen', 'editedDay', 'updatedBy', 'updatedAt'])
    && isLunchChoices(choiceId, request.resource.data)
    && request.resource.data.get('options', {})
         .diff(resource.data.get('options', {})).affectedKeys()
         .hasOnly(lunchDayKeys(request.resource.data.editedDay))
    && request.resource.data.get('chosen', {})
         .diff(resource.data.get('chosen', {})).affectedKeys()
         .hasOnly(lunchDayKeys(request.resource.data.editedDay))
    && isOwnMember(householdId, request.resource.data.updatedBy)
    && isServerTime('updatedAt')
    && lunchOptionsAreSafe(householdId, resource.data.childId,
         request.resource.data.get('options', {}),
         request.resource.data.get('options', {})
           .diff(resource.data.get('options', {})).affectedKeys(),
         request.resource.data.editedDay);

  // The child says which slot they chose, and what — nothing else.
  allow update: if lunchKidOwnsWeek(householdId, choiceId)
    && onlyChanged(['chosen', 'chosenKey'])
    && isLunchSlotKey(request.resource.data.chosenKey)
    && request.resource.data.get('chosen', {})
         .diff(resource.data.get('chosen', {})).affectedKeys()
         .hasOnly([request.resource.data.chosenKey]);

  allow delete: if canEdit(householdId, 'lunch');
}

// The child's choice, into their own plan — in the same batch as the
// choices document naming the slot, which is read after the batch. A choice
// is a plan write, held to the free tier like a parent's (`lunchPlansFor`,
// lunch-box ADR-0009).
match /lunchPlans/{planId} {
  allow create: if resource == null
    && lunchKidOwnsWeek(householdId, planId)
    && isLunchKidPlan(planId, request.resource.data)
    && isLunchChild(householdId, request.resource.data.childId)
    && lunchPlansFor(householdId, request.resource.data.childId)
    && lunchKidChoiceIsApproved(householdId, planId, request.resource.data.childId,
         request.resource.data.slots, request.resource.data.slots.keys());

  allow update: if resource != null
    && lunchKidOwnsWeek(householdId, planId)
    && onlyChanged(['slots'])
    && lunchPlansFor(householdId, resource.data.childId)
    && lunchKidChoiceIsApproved(householdId, planId, resource.data.childId,
         request.resource.data.get('slots', {}),
         request.resource.data.get('slots', {})
           .diff(resource.data.get('slots', {})).affectedKeys());
}

// A kid device or member whose lunch grant is `own`, on their own week.
// The week is asked first: it is cheap and false for everybody who is not
// that child, and this rule is evaluated beside lunch_box.rules' on every
// plan write — a grant looked up twice cost a helper at edit a day's pack
// (the 1000-expression limit, lunch-box ADR-0010).
function lunchKidOwnsWeek(householdId, weekDocumentId) {
  return isLunchPlanOf(weekDocumentId, ownMemberId(householdId))
    && hasOwnOnly(householdId, 'lunch');
}

function isLunchSlotKey(key) {
  return key is string && key.matches('^[1-5]_(main|fruit|veg|snack|treat)$');
}

// The five slot keys of one school day.
function lunchDayKeys(day) {
  return [day + '_main', day + '_fruit', day + '_veg', day + '_snack', day + '_treat'];
}

function isLunchChoices(choiceId, data) {
  return data.keys().hasOnly(
         ['childId', 'week', 'options', 'chosen', 'editedDay', 'chosenKey', 'updatedBy', 'updatedAt'])
    && data.childId is string
    && data.week is string && data.week.matches('^[0-9]{4}-W[0-9]{2}$')
    && choiceId == data.childId + '_' + data.week
    && data.get('options', {}) is map
    && data.get('chosen', {}) is map
    && data.editedDay is string && data.editedDay.matches('^[1-5]$')
    && data.updatedBy is string;
}

// An option's keys and nothing the child must avoid — as light as the plan's
// `lunchPickIsSafe`, because a day holds up to fifteen (lunch-box ADR-0010).
// An option reaches a box only through a child's choice, and that write is
// checked again against the plan's allergy rule.
function isLunchOptionSafe(option, avoid) {
  return option.keys().hasOnly(['itemId', 'name', 'allergens'])
    && !option.get('allergens', []).hasAny(avoid);
}

function isLunchOptionList(options, avoid) {
  return options is list
    && options.size() >= 2 && options.size() <= 3
    && isLunchOptionSafe(options[0], avoid)
    && isLunchOptionSafe(options[1], avoid)
    && (options.size() < 3 || isLunchOptionSafe(options[2], avoid));
}

function lunchOptionIsSafe(options, changed, avoid, key) {
  return !(key in changed) || !(key in options) || isLunchOptionList(options[key], avoid);
}

// The one day this write changed, slot by slot. A slot whose options were
// taken away is fine.
// Each argument bound once with `let` before fifteen options use it
// (lunch-box ADR-0010).
function lunchOptionsAreSafe(householdId, childId, options, changed, day) {
  let theOptions = options;
  let theChanged = changed;
  let theDay = day;
  return theChanged.size() == 0
    || lunchOptionsAreSafeFor(householdId, childId, theOptions, theChanged, theDay);
}

function lunchOptionsAreSafeFor(householdId, childId, options, changed, day) {
  let avoid = lunchAvoidFor(householdId, childId);
  return lunchOptionDayIsSafe(options, changed, avoid, day);
}

function lunchOptionDayIsSafe(options, changed, avoid, day) {
  return lunchOptionIsSafe(options, changed, avoid, day + '_main')
    && lunchOptionIsSafe(options, changed, avoid, day + '_fruit')
    && lunchOptionIsSafe(options, changed, avoid, day + '_veg')
    && lunchOptionIsSafe(options, changed, avoid, day + '_snack')
    && lunchOptionIsSafe(options, changed, avoid, day + '_treat');
}

// A new plan a child's first choice creates: the week it says, one slot.
function isLunchKidPlan(planId, data) {
  return data.keys().hasOnly(['childId', 'week', 'weekStart', 'slots'])
    && data.childId is string
    && data.week is string && data.week.matches('^[0-9]{4}-W[0-9]{2}$')
    && planId == data.childId + '_' + data.week
    && data.weekStart is string && data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && data.slots is map;
}

// Exactly one slot changed — the one the choices document names after the
// batch — and it now holds one of that slot's approved options, which is
// safe for the child as their profile stands now.
function lunchKidChoiceIsApproved(householdId, planId, childId, slots, changed) {
  let path = /databases/$(database)/documents/households/$(householdId)/lunchChoices/$(planId);
  return existsAfter(path)
    && lunchKidChoiceIsOneOf(getAfter(path).data, slots, changed)
    && lunchKidPickIsSafe(slots[getAfter(path).data.chosenKey], lunchAvoidFor(householdId, childId));
}

// The chosen pick in full — the plan's own shape and vocabulary, since this
// is the one place an option lands in a box — with nothing the child must
// avoid.
function lunchKidPickIsSafe(pick, avoid) {
  return isLunchPick(pick) && !pick.get('allergens', []).hasAny(avoid);
}

function lunchKidChoiceIsOneOf(choices, slots, changed) {
  return isLunchSlotKey(choices.get('chosenKey', null))
    && changed.size() == 1
    && changed.hasOnly([choices.chosenKey])
    && choices.chosenKey in slots
    && slots[choices.chosenKey] in choices.get('options', {}).get(choices.chosenKey, []);
}
