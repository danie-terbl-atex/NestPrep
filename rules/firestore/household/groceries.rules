// ---- groceries (groceries ADR-0002, which keeps ADR-0001's list) ----

// An item the week's plans put on the list carries three source fields —
// `sourceKey`, `sourceWeek`, `sourceNote` — and a typed item has none (or
// all three null). Nobody owns an unbought planned item, so any groceries
// editor may refresh or remove one; a person's edit adopts it by clearing
// the three fields; a ticked one is history like any other.
//
// `productMatch` is the product a member picked at Checkers (the Checkers
// build contract): absent on a new item, set or cleared by any groceries
// editor on its own, and cleared — never required to be — by a rename, so an
// app from before the field still renames an item that carries one.
match /groceryItems/{itemId} {
  allow read: if canView(householdId, 'groceries');

  allow create: if canEdit(householdId, 'groceries')
    && request.resource.data.keys().hasOnly(
         ['name', 'quantity', 'addedBy', 'addedAt', 'boughtAt', 'boughtBy',
          'sourceKey', 'sourceWeek', 'sourceNote', 'productMatch'])
    && request.resource.data.get('productMatch', null) == null
    && isNonEmptyString(request.resource.data.name)
    && isOwnMember(householdId, request.resource.data.addedBy)
    && isServerTime('addedAt')
    && request.resource.data.boughtAt == null
    && request.resource.data.boughtBy == null
    && groceriesSourceIsValid(request.resource.data);

  // Three different writes share this rule, and a caller may do exactly one
  // of them: anybody in the household ticks anything; the plans refresh an
  // unbought planned item; only the person who added an item — or an admin,
  // or anybody for a planned one — changes what it says.
  allow update: if canEdit(householdId, 'groceries')
    && didNotChange('addedBy')
    && didNotChange('addedAt')
    && (isTickOrUntick(householdId)
          || groceriesIsPlanRefresh()
          || isTextEdit(householdId)
          || groceriesIsProductPick(householdId));

  allow delete: if isAdmin(householdId)
    || (canEdit(householdId, 'groceries')
          && (isOwnMember(householdId, resource.data.addedBy)
                || groceriesIsUnboughtPlanned(resource.data)));

  function isTickOrUntick(householdId) {
    return onlyChanged(['boughtAt', 'boughtBy'])
      && (request.resource.data.boughtAt == null
            ? request.resource.data.boughtBy == null
            : isServerTime('boughtAt')
                && isOwnMember(householdId, request.resource.data.boughtBy));
  }

  // A person's edit. Saving it clears the source fields, so a planned item
  // becomes theirs and the plans leave it alone from then on.
  // A pick that was there may only be cleared by it, never swapped.
  function isTextEdit(householdId) {
    return onlyChanged(['name', 'quantity', 'sourceKey', 'sourceWeek', 'sourceNote', 'productMatch'])
      && (request.resource.data.get('productMatch', null) == null
            || request.resource.data.get('productMatch', null)
                 == resource.data.get('productMatch', null))
      && isNonEmptyString(request.resource.data.name)
      && request.resource.data.get('sourceKey', null) == null
      && request.resource.data.get('sourceWeek', null) == null
      && request.resource.data.get('sourceNote', null) == null
      && (isAdmin(householdId)
            || isOwnMember(householdId, resource.data.addedBy)
            || groceriesIsPlanned(resource.data));
  }

  // A member picks the item's product, or clears the pick, and nothing else
  // moves. The pick is stamped with who made it and the server's time.
  function groceriesIsProductPick(householdId) {
    return onlyChanged(['productMatch'])
      && (request.resource.data.get('productMatch', null) == null
            || groceriesIsProductMatch(householdId, request.resource.data.productMatch));
  }

  // The plans bring an unbought planned item's amount and reasons up to
  // date; nothing else about it moves.
  function groceriesIsPlanRefresh() {
    return groceriesIsUnboughtPlanned(resource.data)
      && onlyChanged(['quantity', 'sourceNote'])
      && groceriesIsSourceNote(request.resource.data.sourceNote);
  }
}

function groceriesIsPlanned(data) {
  return data.get('sourceKey', null) != null;
}

function groceriesIsUnboughtPlanned(data) {
  return groceriesIsPlanned(data) && data.get('boughtBy', null) == null;
}

// All three source fields, well formed, or none of them.
function groceriesSourceIsValid(data) {
  return data.get('sourceKey', null) == null
    ? data.get('sourceWeek', null) == null && data.get('sourceNote', null) == null
    : data.sourceKey is string
        && data.sourceKey.size() > 0
        && data.sourceKey.size() <= 80
        && data.sourceKey == data.sourceKey.lower()
        && data.get('sourceWeek', null) is string
        && data.sourceWeek.matches('^[0-9]{4}-W[0-9]{2}$')
        && groceriesIsSourceNote(data.get('sourceNote', null));
}

function groceriesIsSourceNote(value) {
  return value is string && value.size() <= 200;
}

// The shape of a pick (the Checkers build contract). The unit is any short
// code Checkers sends — `EA`, `KG`, `PK1` — because the server decides what a
// weighed item is, not the rules; the price is whole cents in rand.
function groceriesIsProductMatch(householdId, pick) {
  return pick is map
    && pick.keys().hasAll(['retailer', 'productId', 'articleCode', 'unitOfMeasure', 'name',
                            'brand', 'priceCents', 'currency', 'imageId', 'pickedBy', 'pickedAt'])
    && pick.keys().hasOnly(['retailer', 'productId', 'articleCode', 'unitOfMeasure', 'name',
                             'brand', 'priceCents', 'currency', 'imageId', 'pickedBy', 'pickedAt'])
    && pick.retailer == 'checkers'
    && pick.productId is string
    && pick.productId.matches('^[0-9a-f]{24}$')
    && pick.articleCode is string
    && pick.articleCode.matches('^[0-9A-Za-z]{1,40}$')
    && pick.unitOfMeasure is string
    && pick.unitOfMeasure.matches('^[A-Z0-9]{1,8}$')
    && isNonEmptyString(pick.name)
    && pick.name.size() <= 200
    && (pick.brand == null || (pick.brand is string && pick.brand.size() <= 100))
    && pick.priceCents is int
    && pick.priceCents >= 0
    && pick.priceCents <= 100000000
    && pick.currency == 'ZAR'
    && (pick.imageId == null || (pick.imageId is string && pick.imageId.size() <= 100))
    && isOwnMember(householdId, pick.pickedBy)
    && pick.pickedAt == request.time;
}
