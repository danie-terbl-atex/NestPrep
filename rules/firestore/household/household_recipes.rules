// ---- household recipes (recipes ADR-0002, ADR-0007) ----
// `ai` is read by id with lunch; `own` is listed with meals. Only Functions
// write either: allergen codes come from word lists no rule can run.

match /recipes/{recipeId} {
  allow get: if canView(householdId, 'lunch')
    || (canView(householdId, 'meals')
          && (resource == null || resource.data.source == 'own'));
  allow list: if canView(householdId, 'meals')
    && resource.data.source == 'own'
    && request.query.limit <= 300;
  allow write: if false;
}
