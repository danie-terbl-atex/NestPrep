// ---- where a member has been, and when they reached a place (live-location ADR-0004, ADR-0006) ----
//
// Keyed by the member id like `memberLocations`, so only that member's own
// device writes their history. One document per household-local day holds
// every point of it: a day is one read, and the bill is one write a flush.
match /locationTrails/{memberId} {
  match /trailDays/{day} {
    allow read: if canView(householdId, 'location');

    allow create: if isOwnMember(householdId, memberId)
      && hasPremium(householdId)
      && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && isLocationTrailDay(request.resource.data)
      && request.resource.data.points.size() <= 120;

    // `arrayUnion` only ever adds, at most 120 points a flush, a flush at most
    // every 30 seconds, and a day holds at most 3,000.
    allow update: if isOwnMember(householdId, memberId)
      && hasPremium(householdId)
      && isLocationTrailDay(request.resource.data)
      && request.resource.data.points.size() <= 3000
      && request.resource.data.points.size() >= resource.data.points.size()
      && request.resource.data.points.size() - resource.data.points.size() <= 120
      && request.time > resource.data.updatedAt + duration.value(30, 's');

    allow delete: if isOwnMember(householdId, memberId) || isAdmin(householdId);
  }

  match /placeEvents/{eventId} {
    allow read: if canView(householdId, 'location');

    allow create: if isOwnMember(householdId, memberId)
      && hasPremium(householdId)
      && request.resource.data.keys().hasOnly(['placeId', 'kind', 'at', 'expiresAt'])
      && request.resource.data.kind in ['arrive', 'leave']
      && request.resource.data.placeId is string
      && exists(/databases/$(database)/documents/households/$(householdId)/places/$(request.resource.data.placeId))
      && isServerTime('at')
      && isLocationTrailExpiry(request.resource.data.expiresAt);

    allow update: if false;
    allow delete: if isOwnMember(householdId, memberId) || isAdmin(householdId);
  }

  function isLocationTrailDay(data) {
    return data.keys().hasOnly(['points', 'updatedAt', 'expiresAt'])
      && data.points is list
      && isServerTime('updatedAt')
      && isLocationTrailExpiry(data.expiresAt);
  }

  // Thirty days, give or take the device's clock. The TTL policy on
  // `expiresAt` is what deletes it.
  function isLocationTrailExpiry(expiresAt) {
    return expiresAt is timestamp
      && expiresAt > request.time + duration.value(29, 'd')
      && expiresAt < request.time + duration.value(31, 'd');
  }
}
