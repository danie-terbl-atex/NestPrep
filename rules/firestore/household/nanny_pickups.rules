// ---- nanny hub: who may collect each child (nanny-hub ADR-0005) ----
//
// Who may collect a child is family's decision alone — not the `nannyHub`
// grant's. A carer at `edit` authors cards and keeps the log, but must never
// be able to add a name to the list of people a child may be released to.
// Whoever reads the hub reads the list, the school-run schedule and its
// changes, so a carer at the door can check it.

// A person a child may be released to: a photo and a relationship or ID
// note to recognise them by, and the children they may collect.
match /nannyPickupPeople/{personId} {
  allow read: if canView(householdId, 'nannyHub');

  allow create: if isFamily(householdId)
    && request.resource.data.keys().hasOnly(
         ['name', 'relationship', 'idNote', 'phone', 'photoId', 'childIds',
          'createdBy', 'createdAt'])
    && isNannyPickupPerson(request.resource.data)
    && isOwnMember(householdId, request.resource.data.createdBy)
    && isServerTime('createdAt');

  allow update: if isFamily(householdId)
    && onlyChanged(['name', 'relationship', 'idNote', 'phone', 'photoId', 'childIds'])
    && isNannyPickupPerson(request.resource.data);

  allow delete: if isFamily(householdId);
}

// Who collects one child on one weekday — keyed so there is exactly one.
match /nannySchoolRuns/{runId} {
  allow read: if canView(householdId, 'nannyHub');

  allow create, update: if isFamily(householdId)
    && request.resource.data.keys().hasOnly(
         ['childId', 'weekday', 'personId', 'memberId', 'atMinute', 'place',
          'updatedBy', 'updatedAt'])
    && request.resource.data.weekday is int
    && request.resource.data.weekday >= 1
    && request.resource.data.weekday <= 7
    && runId == request.resource.data.childId + '_' + string(request.resource.data.weekday)
    && isNannyCollector(request.resource.data, true)
    && isNannyMinute(request.resource.data.get('atMinute', null))
    && isNannyOptionalText(request.resource.data.get('place', null), 80)
    && isOwnMember(householdId, request.resource.data.updatedBy)
    && isServerTime('updatedAt');

  allow delete: if isFamily(householdId);
}

// One child's school run on one date, instead of the weekday's. Nobody named
// means nobody collects that day.
match /nannyPickupChanges/{changeId} {
  allow read: if canView(householdId, 'nannyHub');

  allow create, update: if isFamily(householdId)
    && request.resource.data.keys().hasOnly(
         ['childId', 'date', 'personId', 'memberId', 'atMinute', 'note',
          'updatedBy', 'updatedAt'])
    && request.resource.data.date is string
    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && changeId == request.resource.data.childId + '_' + request.resource.data.date
    && isNannyCollector(request.resource.data, false)
    && isNannyMinute(request.resource.data.get('atMinute', null))
    && isNannyOptionalText(request.resource.data.get('note', null), 200)
    && isOwnMember(householdId, request.resource.data.updatedBy)
    && isServerTime('updatedAt');

  allow delete: if isFamily(householdId);
}

// The limits are `NannyLimits` in the app; `nanny_v2_contract_test.dart`
// reads this file.
function isNannyPickupPerson(data) {
  return isNannyText(data.name, 60)
    && isNannyText(data.relationship, 40)
    && isNannyOptionalText(data.get('idNote', null), 200)
    && (data.get('phone', null) == null
          || (data.phone is string && data.phone.matches('^[+0-9 ()-]{3,20}$')))
    && isNannyPhotoId(data.get('photoId', null))
    && data.childIds is list
    && data.childIds.size() <= 10;
}

// A collector is a pickup person or a household member — one of the two,
// never both. [isRequired]: a school run must name somebody; a change may
// name nobody.
function isNannyCollector(data, isRequired) {
  let person = data.get('personId', null);
  let member = data.get('memberId', null);
  return (person == null || isNonEmptyString(person))
    && (member == null || isNonEmptyString(member))
    && !(person != null && member != null)
    && (!isRequired || person != null || member != null);
}

function isNannyMinute(value) {
  return value == null || (value is int && value >= 0 && value <= 1439);
}
