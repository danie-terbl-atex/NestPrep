{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "hosting/public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["**/.*", "**/node_modules/**"],
    "predeploy": ["node hosting/tools/build-site.mjs --check"],
    "rewrites": [
      {
        "source": "/api/account-deletion-request",
        "function": { "functionId": "requestAccountDeletion", "region": "europe-west1" }
      },
      {
        "source": "/api/premium/**",
        "function": { "functionId": "premiumWeb", "region": "europe-west1" }
      },
      {
        "source": "/mcp",
        "function": { "functionId": "assistantMcp", "region": "europe-west1" }
      },
      {
        "source": "/oauth/**",
        "function": { "functionId": "assistantAuth", "region": "europe-west1" }
      },
      {
        "source": "/.well-known/oauth-protected-resource",
        "function": { "functionId": "assistantAuth", "region": "europe-west1" }
      },
      {
        "source": "/.well-known/oauth-protected-resource/**",
        "function": { "functionId": "assistantAuth", "region": "europe-west1" }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "function": { "functionId": "assistantAuth", "region": "europe-west1" }
      },
      {
        "source": "/.well-known/oauth-authorization-server/**",
        "function": { "functionId": "assistantAuth", "region": "europe-west1" }
      },
      { "source": "/invite/**", "destination": "/invite/index.html" },
      { "source": "/premium/**", "destination": "/premium/index.html" },
      { "source": "/.well-known/assetlinks.json", "destination": "/well-known/assetlinks.json" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"
          },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "/connect",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://nestprep-643b7.firebaseapp.com; object-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"
          },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      },
      {
        "source": "/__/auth/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://nestprep-643b7.web.app https://mcp.nestprep.io; object-src 'none'; base-uri 'none'"
          }
        ]
      },
      {
        "source": "{/mcp,/oauth/**,/.well-known/oauth-*,/.well-known/oauth-*/**,/api/premium/**}",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "{/premium,/premium/**}",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
