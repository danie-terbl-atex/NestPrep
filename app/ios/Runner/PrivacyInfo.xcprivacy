<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NestPrep's privacy manifest. What it declares, and why each line is here, is
  the vault's nestprep-project/launch/nestprep-store-privacy-answers.md; the App
  Store privacy label must say the same. Nothing is used for tracking and no
  data is shared with a third party for its own purposes. Pods and plugins
  (Firebase, Crashlytics, image_picker, local_auth and the rest) ship their own
  manifests for the APIs their code calls; these are the app's.
-->
<plist version="1.0">
