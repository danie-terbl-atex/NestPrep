<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Push notifications on iOS (notifications ADR-0001, foundation ADR on the Peak
  team). Exporting for the App Store turns `development` into `production`.
  FCM delivers through the Peak team's APNs auth key, uploaded to the Firebase
  project for the iOS app io.nullstate.nestprep.app.

  Sign in with Apple (accounts ADR-0014) needs the apple.com provider on
  nestprep-643b7 configured with this bundle id and a Peak code-flow key.

  The associated domains let iOS offer to save a NestPrep password to the
  Keychain, filed under app.nestprep.io (accounts ADR-0013), and open invite
  and frame links on our three hosts in the app (household ADR-0012). Each
  host serves the matching apple-app-site-association file.

  The app group is the one place the ShareToFrame extension can leave a shared
  PDF for the app to take (recipes ADR-0009).
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.nullstate.nestprep.app</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.nestprep.io</string>
		<string>applinks:app.nestprep.io</string>
		<string>applinks:nestprep-643b7.web.app</string>
		<string>applinks:nestprep-643b7.firebaseapp.com</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
