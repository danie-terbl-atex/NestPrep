<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Push notifications on iOS (notifications ADR-0001, foundation ADR on the Peak
  team). Exporting for the App Store turns `development` into `production`.
  FCM only delivers once the Peak team's APNs auth key is uploaded to the
  Firebase project (Project settings → Cloud Messaging → the iOS app
  io.nullstate.nestprep.app).
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
