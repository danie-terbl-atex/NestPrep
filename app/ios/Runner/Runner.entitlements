<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Push notifications on iOS (notifications ADR-0001, foundation ADR on the Peak
  team). Exporting for the App Store turns `development` into `production`.
  FCM only delivers once the Peak team's APNs auth key is uploaded to the
  Firebase project (Project settings → Cloud Messaging → the iOS app
  io.nullstate.nestprep.app).

  The associated domain lets iOS offer to save a NestPrep password to the
  Keychain, filed under app.nestprep.io, which serves the matching
  apple-app-site-association file (accounts ADR-0013).
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.nestprep.io</string>
	</array>
</dict>
</plist>
