<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same exclusions as nestprep_backup_rules.xml,
     for cloud backup and for moving to a new phone (documents ADR-0007). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline_documents/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline_documents/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
