rules_version = '2';

// GENERATED by `npm --prefix functions run rules:build` from rules/storage/.
// Do not edit this file: edit the partial named above each block, then build.
// A merge conflict here is never resolved by hand — take either side and build.
//
// NestPrep's authorisation layer for the bytes a household keeps (documents
// ADR-0001). Same posture as `firestore.rules`: deny by default, every match
// states who may read and who may write, and every rule has an allowed and a
// denied test in `functions/test/rules/` (BE-05, BE-14).
//
// The difference that shapes this whole file: **Storage rules cannot read
// Firestore the cheap way.** The uid→role map every Firestore rule consults
// arrives here as a custom claim on the caller's ID token —
// `households: { householdId: role }` plus `access` for per-area grants —
// which the Functions write from what Firestore already says. A claim is up to
// an hour stale after a removal; a path that must refuse at once (the vaults,
// home care's job photos) pays for a live cross-service `firestore.get()`.
service firebase.storage {
  match /b/{bucket}/o {
    // ==== rules/storage/shared/caller.rules ====
    // ---- what the caller is in a household ----

    function households() {
      return request.auth.token.households;
    }

    function isMember(householdId) {
      return request.auth != null
        && households() is map
        && householdId in households();
    }

    function isAdmin(householdId) {
      return isMember(householdId) && households()[householdId] == 'admin';
    }

    // ---- what the caller may see and do, per area (household ADR-0003) ----
    //
    // The same answer `firestore.rules` gives, from the token instead of a
    // `get()`. Family — admin, parent, the old `member` — sees everything. A
    // kid, helper or carer carries a second claim, `access`, holding a level
    // per area for the areas whose bytes live here; an area missing from it is
    // `none`. Both claims are written from Firestore by the Functions, never
    // by a client.

    function isFamily(householdId) {
      return isMember(householdId)
        && households()[householdId] in ['admin', 'parent', 'member'];
    }

    // A token with no `access` claim at all predates ADR-0003: a helper on it
    // keeps the `edit` every helper had, exactly as `firestore.rules` treats a
    // helper with no grant. Once the claim exists, a household missing from it
    // is `none`.
    function levelIn(householdId, area) {
      return !('access' in request.auth.token)
        ? (households()[householdId] == 'helper' ? 'edit' : 'none')
        : request.auth.token.access.get(householdId, {}).get(area, 'none');
    }

    function canView(householdId, area) {
      return isFamily(householdId)
        || (isMember(householdId) && levelIn(householdId, area) in ['view', 'edit']);
    }

    function canEdit(householdId, area) {
      return isFamily(householdId)
        || (isMember(householdId) && levelIn(householdId, area) == 'edit');
    }

    // Storage rules know uids; Firestore rules know member profiles. Both are
    // the same person through `claimedBy`, and stamping the uid on the object
    // is what lets a delete rule agree with the Firestore rule on the
    // metadata row that shares this object's name.
    function isStampedWithTheCaller() {
      return request.resource.metadata.uploadedByUid == request.auth.uid;
    }

    // ==== rules/storage/shared/document_files.rules ====
    // ---- what a document may be (documents ADR-0001) ----
    //
    // The household's documents and the personal vaults keep the same files.
    // Photo features keep their own caps in their own partials.

    // Enforced here and nowhere else that counts. The client refuses an
    // oversized or unreadable file earlier so a person is not made to wait for
    // a refusal, but that check is a courtesy and this one is the rule
    // (FE-04, BE-20). `document_limits_match_the_rules_test.dart` reads this
    // partial and fails when the two drift apart.
    function isSmallEnough() {
      return request.resource.size <= 20 * 1024 * 1024;
    }

    // What a household actually keeps: a scan or a photo of a piece of paper.
    function isAKeptType() {
      return request.resource.contentType in [
        'application/pdf',
        'image/jpeg',
        'image/png',
        'image/heic',
        'image/webp'
      ];
    }

    // ==== rules/storage/shared/shift_window.rules ====
    // ---- shift-only carers (nanny-hub ADR-0006) ----
    //
    // The Storage half of `rules/firestore/shared/shift_window.rules`. A carer a
    // parent marked shift-only sees the household only from 15 minutes before a
    // shift booked for them to 15 minutes after it ends — in Firestore through
    // `memberLevelIn`, here through `isOnShiftIfShiftOnly` beside each path's
    // area check. A token cannot know the time, so this reads Firestore live:
    // the household document says who is shift-only (only Functions write it),
    // and the carer's pass carries the booked times, which the Firestore rules
    // checked against the booking when the pass was written. Family is never
    // narrowed and costs no read; anybody else costs one read (the household),
    // and a shift-only carer two.
    //
    // A read that fails — too many cross-service reads on a path that already
    // reads Firestore — refuses, which is the safe side for somebody off shift.

    function isShiftWindowPassOpen(householdId, memberId) {
      let pass = firestore.get(/databases/(default)/documents/households/$(householdId)/nannyShiftPasses/$(memberId));
      return pass != null
        && request.time >= pass.data.startsAt - duration.value(15, 'm')
        && request.time <= pass.data.endsAt + duration.value(15, 'm');
    }

    // A household document it cannot find marks nobody shift-only: the token
    // already said this caller is in the household.
    function isShiftOnlyOffShift(householdId) {
      let household = firestore.get(/databases/(default)/documents/households/$(householdId));
      let memberId = household == null
        ? ''
        : household.data.get('profiles', {}).get(request.auth.uid, '');
      return memberId != ''
        && household.data.get('shiftOnly', {}).get(memberId, false) == true
        && !isShiftWindowPassOpen(householdId, memberId);
    }

    // What every non-family branch of a household path adds.
    function isOnShiftIfShiftOnly(householdId) {
      return isFamily(householdId) || !isShiftOnlyOffShift(householdId);
    }

    // ==== rules/storage/paths/document_vaults.rules ====
    // ---- personal vaults (documents ADR-0002, ADR-0003) ----
    //
    // Unlike the household's documents above, a vault object is authorised
    // **live, from Firestore** — cross-service rules — never by the token
    // claim, so a revoked grant or a removed member is refused on the next
    // request rather than an hour later. At most two Firestore documents are
    // read per request.
    //
    // The object is `households/{h}/vaults/{memberId}/{documentId}`, and its
    // metadata row is `…/vaults/{memberId}/vaultDocuments/{documentId}` — the
    // same id, for the same reason as above.
    match /households/{householdId}/vaults/{ownerMemberId}/{documentId} {
      function householdDoc() {
        return firestore.get(/databases/(default)/documents/households/$(householdId)).data;
      }

      // Family — `admin`, `parent`, and `member`, read as `parent` (household
      // ADR-0003) — manages every vault; per-item privacy between family
      // members is out of v1.
      function isVaultFamily() {
        return request.auth != null
          && householdDoc().members.get(request.auth.uid, '') in ['admin', 'parent', 'member'];
      }

      // The account that claimed the vault's profile, while still a member.
      function isVaultOwner() {
        return request.auth != null
          && firestore.get(/databases/(default)/documents/households/$(householdId)/members/$(ownerMemberId)).data.claimedBy == request.auth.uid
          && request.auth.uid in householdDoc().members;
      }

      // Written only by `openVaultDocument`, after it checked who may read
      // this vault and wrote the view-log entry in the same batch. No client
      // can write one, so no vault bytes are read without a log line.
      function openingTicket() {
        return firestore.get(/databases/(default)/documents/households/$(householdId)/vaultOpenings/$(request.auth.uid + '_' + documentId)).data;
      }

      allow get: if request.auth != null
        && openingTicket().ownerMemberId == ownerMemberId
        && openingTicket().expiresAt > request.time;

      allow list: if false;

      allow create: if resource == null
        && isSmallEnough()
        && isAKeptType()
        && isStampedWithTheCaller()
        && (isVaultFamily() || isVaultOwner());

      allow update: if false;

      allow delete: if isVaultFamily() || isVaultOwner();
    }

    // ==== rules/storage/paths/documents.rules ====
    // ---- a household's documents (documents ADR-0001) ----
    //
    // The object's name is the id of its metadata document at
    // `households/{householdId}/documents/{documentId}`. They are deliberately
    // the same string: an orphan on either side is findable by listing the
    // other, which is what makes a half-finished upload or delete recoverable
    // rather than an invisible bill (BE-07).
    //
    // A shift-only carer (nanny-hub ADR-0006) reads, lists and adds nothing here
    // off shift, as in Firestore (`shared/shift_window.rules`) — without it a
    // token's `documents` grant would list every file at any hour.
    match /households/{householdId}/documents/{documentId} {
      allow read: if canView(householdId, 'documents') && isOnShiftIfShiftOnly(householdId);

      allow create: if resource == null
        && canEdit(householdId, 'documents')
        && isOnShiftIfShiftOnly(householdId)
        && isSmallEnough()
        && isAKeptType()
        && isStampedWithTheCaller();

      // Bytes are never rewritten in place. Replacing a document is a delete
      // and an add, so "what is in this object" stays answerable from the one
      // metadata row that carries its name.
      allow update: if false;

      allow delete: if isAdmin(householdId)
        || (canEdit(householdId, 'documents')
              && isOnShiftIfShiftOnly(householdId)
              && resource.metadata.uploadedByUid == request.auth.uid);
    }

    // ==== rules/storage/paths/home_care.rules ====
    // ---- home care photos (home-care ADR-0003) ----
    //
    // A job's before photo and each after photo it was handed in with:
    // `households/{h}/homeCareJobs/{jobId}/before` and `…/after-{revision}`.
    // Authorised **live from Firestore**, like the vaults: `own` means "the
    // jobs whose helper is my profile", which only the job document knows,
    // and a grant a parent narrows is refused on the next request. At most
    // two Firestore documents are read per request — the household and the
    // job — and a third, the pass, only for a carer marked shift-only, who is
    // refused off shift (nanny-hub ADR-0006, `shared/shift_window.rules`).
    match /households/{householdId}/homeCareJobs/{jobId}/{photoId} {
      function homeCareHousehold() {
        return firestore.get(/databases/(default)/documents/households/$(householdId)).data;
      }

      function homeCareJob() {
        return firestore.get(/databases/(default)/documents/households/$(householdId)/homeCareJobs/$(jobId)).data;
      }

      // household ADR-0003's level in `homeCare`, as `access.rules` works it
      // out: family edits; a grant says what it says; a helper claimed
      // before grants existed keeps `edit`; anybody else has nothing.
      function homeCareLevel() {
        let household = homeCareHousehold();
        let role = household.members.get(request.auth.uid, '');
        let grant = household.get('access', {}).get(request.auth.uid, null);
        return role in ['admin', 'parent', 'member'] ? 'edit'
          : role == '' ? 'none'
          : grant != null ? grant.get('homeCare', 'none')
          : (role == 'helper' ? 'edit' : 'none');
      }

      function isTheJobsHelper() {
        return homeCareJob().helperId
          == homeCareHousehold().get('profiles', {}).get(request.auth.uid, '');
      }

      function isAJobPhoto() {
        return request.resource.contentType == 'image/jpeg'
          && request.resource.size <= 5 * 1024 * 1024
          && isStampedWithTheCaller();
      }

      allow read: if request.auth != null
        && isOnShiftIfShiftOnly(householdId)
        && (homeCareLevel() in ['view', 'edit']
              || (homeCareLevel() == 'own' && isTheJobsHelper()));

      // The before photo goes up first; the job that names it is written
      // after the bytes are there.
      allow create: if request.auth != null
        && resource == null
        && isOnShiftIfShiftOnly(householdId)
        && isAJobPhoto()
        && ((photoId == 'before' && homeCareLevel() == 'edit')
              || (photoId.matches('after-[0-9]+')
                    && homeCareJob().status in ['assigned', 'inProgress', 'sentBack']
                    && (homeCareLevel() == 'edit'
                          || (homeCareLevel() in ['own', 'view'] && isTheJobsHelper()))));

      allow update: if false;

      allow delete: if request.auth != null
        && homeCareLevel() == 'edit'
        && isOnShiftIfShiftOnly(householdId);
    }

    // ==== rules/storage/paths/nanny_hub.rules ====
    // ---- nanny hub photos (nanny-hub ADR-0003) ----
    //
    // House-guide spots, child cards and handover entries point at a photo by
    // id; its bytes live here, one level under the household. The app
    // compresses every photo to a JPEG before it leaves the phone, so the cap
    // is small on purpose: a photo past it was not made by the app. Whoever
    // may read the hub sees them; whoever may write it adds them; a photo is
    // removed by whoever added it, or by family.
    //
    // A carer a parent marked shift-only (nanny-hub ADR-0006) is refused outside
    // their booked window (`shared/shift_window.rules`).
    match /households/{householdId}/nannyHub/{photoId} {
      allow read: if canView(householdId, 'nannyHub') && isOnShiftIfShiftOnly(householdId);

      allow create: if resource == null
        && canEdit(householdId, 'nannyHub')
        && isOnShiftIfShiftOnly(householdId)
        && photoId.matches('^[A-Za-z0-9_-]{8,64}$')
        // 2 MiB, written as bytes — the number `nanny_contract_test.dart` reads.
        && request.resource.size <= 2097152
        && request.resource.contentType == 'image/jpeg'
        && isStampedWithTheCaller();

      allow update: if false;

      allow delete: if isFamily(householdId)
        || (canEdit(householdId, 'nannyHub')
              && isOnShiftIfShiftOnly(householdId)
              && resource.metadata.uploadedByUid == request.auth.uid);
    }

    // Everything not named above (BE-05).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
